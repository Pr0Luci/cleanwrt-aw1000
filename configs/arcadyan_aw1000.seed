# CleanWRT build config - Arcadyan AW1000 (Qualcomm IPQ8074)
# Based on OpenWrt 25.12.5 + Passwall2 + QModem + 3ginfo-lite (CEREG patch).
# Kernel 6.12.94, target qualcommax/ipq807x.

# ── Branding / version identity ──────────────────────────────────────────────
# CONFIG_IMAGEOPT is the GATE: VERSIONOPT is `bool ... if IMAGEOPT`
# (package/base-files/image-config.in) and IMAGEOPT defaults to n, so without
# it `make defconfig` resets VERSIONOPT and drops every CONFIG_VERSION_* below,
# falling back to stock "OpenWrt" branding (os-release DISTRIB_ID=OpenWrt,
# openwrt-*.bin). IMAGEOPT only makes the image-config menus visible; the other
# options under it keep their defaults (full defconfig diff verified).
# VERSIONOPT then lets VERSION_DIST rebrand os-release + the LuCI footer, and
# (with VERSION_FILENAMES) the output image becomes
# cleanwrt-<VERSION_NUMBER>-arcadyan_aw1000-*.bin.
CONFIG_IMAGEOPT=y
# Build every kernel module as a package (not installed in the image), like the official
# builder does. The kernel vermagic is the md5 of the kernel's =y/=m symbol set
# (kernel-defaults.mk), so only with the full module set does it equal the vermagic of the
# official kmods repo that files/etc/apk/repositories.d/distfeeds.list points at; without it
# apk upgrade and apk add mwan3 fail on the device.
CONFIG_ALL_KMODS=y
# The official builder also turns kernel KALLSYMS off (its config.buildinfo has
# `# CONFIG_KERNEL_KALLSYMS is not set`); the OpenWrt default is on. KALLSYMS is one of the
# =y symbols in the vermagic hash, so leaving it on gave a different vermagic than the
# official kmods repo even with ALL_KMODS (checked by computing the hash from the official
# config.buildinfo: dbd7ac59..., and from ours with only this symbol differing).
# CONFIG_KERNEL_KALLSYMS is not set
CONFIG_VERSIONOPT=y
CONFIG_VERSION_FILENAMES=y
CONFIG_VERSION_DIST="CleanWRT"
# Version scheme: CleanWRT <openwrt-base>-<stage>, e.g. 25.12.5-rc1, then
# 25.12.5-r1 on stable. The build script re-asserts these after defconfig;
# VERSION_CODE stays empty (no build date). The label is the release candidate
# number: a rebuild before publication keeps it, a fix after publication gets a
# sub-number (rc1.1, rc1.2, ...). Change it here AND in tools/cw-release-build.sh (CW_VERSION)
# together; the script asserts the two agree.
CONFIG_VERSION_NUMBER="25.12.5-rc2"
CONFIG_VERSION_CODE=""
CONFIG_VERSION_PRODUCT="CleanWRT AW1000 5G Router"
CONFIG_VERSION_HWREV="v1"
CONFIG_VERSION_MANUFACTURER="CleanWRT"
# Public identity URLs (resolved 2026-10-06 - the GitHub public mirror).
# NOTE: like all VERSION_*, defconfig drops these; the enforcement is the
# cfg_enable block in tools/cw-release-build.sh (kept in sync).
CONFIG_VERSION_HOME_URL="https://github.com/Pr0Luci/cleanwrt-aw1000"
CONFIG_VERSION_BUG_URL="https://github.com/Pr0Luci/cleanwrt-aw1000/issues"
CONFIG_VERSION_SUPPORT_URL="https://github.com/Pr0Luci/cleanwrt-aw1000/issues"

# ── Target ──────────────────────────────────────────────────────────────────
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_arcadyan_aw1000=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# ── Build options ─────────────────────────────────────────────────────────────
# BUILD_LOG is declared `if DEVEL` in OpenWrt (config/Config-devel.in): without
# CONFIG_DEVEL=y, `make defconfig` drops it silently and ./logs stays empty.
# Per-package logs make compiler warnings and failures analysable after the fact.
# CONFIG_CCACHE=y is deliberately not set: it needs the same DEVEL gate and would
# grow a ~5 GB cache. Re-add it only with a disk plan.
CONFIG_DEVEL=y
CONFIG_BUILD_LOG=y

# ── WiFi (ath11k) ────────────────────────────────────────────────────────────
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-ahb=y
CONFIG_PACKAGE_ath11k-firmware-ipq8074=y
CONFIG_PACKAGE_ipq-wifi-arcadyan_aw1000=y
CONFIG_PACKAGE_hostapd-common=y
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_iw=y
# libiwinfo: the iwinfo CLI guards its dep as `+@!WIFI_SCRIPTS_UCODE:libiwinfo`,
# so with WIFI_SCRIPTS_UCODE=y (the 25.12 default) the library is NOT auto-pulled
# - yet the iwinfo binary still links libiwinfo.so.20230701. Force it on, else
# `package/install` fails: "libiwinfo20230701 (no such package)".
CONFIG_PACKAGE_libiwinfo=y

# ── Ethernet data plane (official base feed) ─────────────────────────────────
CONFIG_PACKAGE_kmod-qca-nss-dp=y
CONFIG_PACKAGE_kmod-qca-ssdk=y

# ── LEDs (SPI GPIO shift register) ───────────────────────────────────────────
CONFIG_PACKAGE_kmod-spi-gpio=y
CONFIG_PACKAGE_kmod-gpio-nxp-74hc164=y
CONFIG_PACKAGE_kmod-leds-gpio=y

# ── 5G modem - kernel (mainline QMI driver) ──────────────────────────────────
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-dwc3=y
CONFIG_PACKAGE_kmod-usb-dwc3-qcom=y
CONFIG_PACKAGE_kmod-usb-wdm=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-qualcomm=y
CONFIG_PACKAGE_kmod-usb-acm=y

# ── USB tethering / backup-WAN sources (multi-WAN; pairs with mwan3 below) ────
# Use a phone / second USB modem / USB ethernet NIC as a failover or alternate
# WAN, so internet survives a 5G outage or data-cap.
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_usb-modeswitch=y
CONFIG_PACKAGE_usbutils=y

# ── 5G modem - userspace ─────────────────────────────────────────────────────
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_luci-proto-qmi=y
CONFIG_PACKAGE_umbim=y
CONFIG_PACKAGE_wwan=y
CONFIG_PACKAGE_sms-tool=y
CONFIG_PACKAGE_comgt=y
CONFIG_PACKAGE_chat=y
# LuCI protocol UIs for the mobile-broadband netifd handlers above (comgt=3g,
# umbim=mbim). Without these, LuCI 404s on protocol/{3g,mbim}.js whenever the
# network model loads (cosmetic console errors across many pages) and these
# USB-modem WAN protocols are not selectable in the UI. luci-proto-qmi (above)
# already ships its JS. NB: the `wwan` meta-protocol has no LuCI handler in the
# feed (no luci-proto-wwan exists), so protocol/wwan.js 404 is upstream-inherent.
CONFIG_PACKAGE_luci-proto-3g=y
CONFIG_PACKAGE_luci-proto-mbim=y

# ── Networking ───────────────────────────────────────────────────────────────
# dnsmasq-full replaces the default dnsmasq (Passwall2 requirement).
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_kmod-ipt-tproxy=y
CONFIG_PACKAGE_kmod-nf-tproxy=y
CONFIG_PACKAGE_kmod-ipt-ipset=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_ip6tables-nft=y
CONFIG_PACKAGE_kmod-nf-socket=y

# ── LuCI core ────────────────────────────────────────────────────────────────
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
# Default theme MUST be selected explicitly: the `luci` meta-package does NOT
# pull a theme in this feed, so without it LuCI renders a fatal error
# ("Failed to load template 'themes/bootstrap/header'") and the web UI is dead.
# luci.main.mediaurlbase starts at /luci-static/bootstrap; files/etc/uci-defaults/
# 96-cw-default-theme switches a fresh install to the Apex theme (bootstrap stays
# installed as the fallback / user choice).
CONFIG_PACKAGE_luci-theme-bootstrap=y
# Default theme: luci-theme-apex (public repo, pinned in configs/local-packages.pin).
CONFIG_PACKAGE_luci-theme-apex=y
# Transitive deps of the luci-mod-* set that a minimal seed must name explicitly,
# else `make defconfig` drops the whole admin UI (status/network -> admin-full):
#   luci-mod-status  needs +libiwinfo +rpcd-mod-iwinfo
#   luci-mod-network needs +rpcd-mod-iwinfo +luci-lib-uqr
CONFIG_PACKAGE_rpcd-mod-iwinfo=y
CONFIG_PACKAGE_luci-lib-uqr=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_rpcd=y
CONFIG_PACKAGE_uhttpd=y
# luci-ssl: HTTPS for the admin UI (ustream-ssl + px5g first-boot cert) so
# credentials never cross the LAN in cleartext; HTTP redirects (files/etc/uci-defaults/46-cw-uhttpd-https).

# ── LuCI apps (official feeds) ───────────────────────────────────────────────
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y
# Attended sysupgrade: ASU client + LuCI page (System -> Attended
# Sysupgrade). Deps from the pinned feeds: attendedsysupgrade-common (packages
# feed) + cgi-io + luci-base (in-image). NOTE: it requests a CUSTOM image from
# an ASU server (uci sysupgrade.client.url); the default public server only
# knows official OpenWrt builds - a CleanWRT ASU server is a future item; safe
# to keep configured-but-unused until then (no background op touches the
# device).
CONFIG_PACKAGE_luci-app-attendedsysupgrade=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_sqm-scripts=y
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-app-adblock=y
# OpenVPN: client+server support; the LuCI app sits under the
# VPN menu (admin/vpn/openvpn); the service needs an ovpn config - ships
# disabled.
CONFIG_PACKAGE_openvpn-openssl=y
CONFIG_PACKAGE_luci-app-openvpn=y
# WireGuard in LuCI is the protocol handler (luci-app-wireguard does not exist):
CONFIG_PACKAGE_luci-proto-wireguard=y

# ── Community packages ───────────────────────────────────────────────────────
# 1. Passwall2. Three upstream SS toggles are broken/undesired and are forced
#    OFF *after* `make defconfig`.
#    They are `default y` upstream, so `make defconfig` RE-ENABLES them even
#    though they are marked off below - these lines document intent only.
#      - Shadowsocks_Rust_Client : rustc host bootstrap 404s (deleted CI LLVM)
#      - ShadowsocksR_Libev      : upstream recipe fails to build
#      - Simple_Obfs             : upstream archived 2019, tarball hash fails
#    xray-core + sing-box + v2ray-plugin cover the same protocol set.
CONFIG_PACKAGE_luci-app-passwall2=y
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Server is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Client is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_ShadowsocksR_Libev_Server is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Simple_Obfs is not set
# Extra proxy cores Passwall2 can use (beyond xray-core/sing-box/v2ray-plugin).
# shadow-tls is EXCLUDED: it is Rust (PKG_BUILD_DEPENDS:=rust/host) and the Rust
# host toolchain does not build here (download-ci-llvm 404 - same reason the
# Shadowsocks-Rust toggle is off). naiveproxy ships as a prebuilt binary (OK).
CONFIG_PACKAGE_hysteria=y
CONFIG_PACKAGE_naiveproxy=y
# CONFIG_PACKAGE_shadow-tls is not set
CONFIG_PACKAGE_ipt2socks=y
CONFIG_PACKAGE_microsocks=y
CONFIG_PACKAGE_dns2socks=y

# 1b. Passwall 1. Same cores as Passwall2 (xray-core + sing-box via
#     Basic_Core_All). The three upstream toggles from the block above are
#     excluded with the same reasons. They default `y` upstream - Shadowsocks_
#     Rust_Client only on aarch64/x86_64, ShadowsocksR_Libev_Client and
#     Simple_Obfs unconditionally - so `make defconfig` re-enables them after
#     the seed marks them off; the release script's broken-toggle pass now
#     covers the passwall1 symbols too (same reasons, same names).
#     Ships DISABLED - LuCI app present, service off by default (repo policy:
#     the proxy stack must not fight the default firewall/DNS setup on
#     first boot).
CONFIG_PACKAGE_luci-app-passwall=y
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_ShadowsocksR_Libev_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs is not set

# 1c. HomeProxy (ImmortalWrt). App + explicit deps the seed does not
#     already carry: the digest ucode module ships inside core package/utils/ucode
#     (v25.12.5), kmod-nft-tproxy is the nftables tproxy front-end (the seed only
#     names kmod-nf-tproxy, the framework), sing-box is named explicitly so
#     neither Passwall2's nor HomeProxy's core selection can drift apart.
#     Cloned into package/ at the commit pinned in configs/local-packages.pin
#     (single-package repo: cannot be feed-indexed). Ships DISABLED.
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_ucode-mod-digest=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_sing-box=y

# 2. 3ginfo-lite (4IceG). The Dialog-style CEREG fix ships as the
#    patches/feeds/3ginfo/ patch applied at build time (data-only SIM registration).
CONFIG_PACKAGE_luci-app-3ginfo-lite=y

# 3. luci-app-cw-led. Front-panel LED daemon + LuCI page (System -> LED Management).
#    Supersedes the stock LED Configuration page stripped by
#    files/etc/uci-defaults/45-cw-strip-stock-leds; cloned into package/ at the commit pinned in configs/local-packages.pin
#    (feed-layout repo: the <name>/ subdirectory is installed as package/<name>).
CONFIG_PACKAGE_luci-app-cw-led=y
CONFIG_PACKAGE_luci-app-adguardhome=y
# AdGuard Home binary: baked into the image (the expanded layout has the room; the
# first-boot installer is gone). Ships stopped: its default bind :53 would fight dnsmasq,
# you enable it from the LuCI page after the first-run wizard (:3000).
CONFIG_PACKAGE_adguardhome=y

# 4. QModem (FUjr).
CONFIG_PACKAGE_luci-app-qmodem=y
CONFIG_PACKAGE_qmodem=y
CONFIG_PACKAGE_qmodem_monitor=y
CONFIG_PACKAGE_sms-forwarder=y
CONFIG_PACKAGE_tom_modem=y
CONFIG_PACKAGE_ubus-at-daemon=y
# QMI-WWAN driver: use the VENDOR-patched drivers (qmodem's own default), NOT
# the mainline generic one. The Quectel RG500Q needs the patched qmi_wwan_q for
# the QMAP/RawIP 5G data path - with the mainline `generic` driver the modem
# registers + gets an IP but NO data flows (wwan0 stuck at raw_ip=N; netifd
# races quectel-CM). The kmods are named directly so `make defconfig` cannot
# drop them (a minimal seed must name transitive deps).
CONFIG_PACKAGE_luci-app-qmodem_INCLUDE_vendor-qmi-wwan=y
CONFIG_PACKAGE_kmod-qmi_wwan_q=y
CONFIG_PACKAGE_kmod-qmi_wwan_f=y
CONFIG_PACKAGE_kmod-qmi_wwan_s=y

# 5. AWvoice (Pr0Luci): the RJ11 phone port. The three packages are pinned in
# configs/local-packages.pin (one repository, feed layout at the repo root).
# The board file the chip needs ships inside awvoice-phoned and is installed at
# the first service start. The service is enabled at boot but the phone is off
# until the line is turned on in the page (the line is never left ringing).
CONFIG_PACKAGE_kmod-awvoice-fxs=y
CONFIG_PACKAGE_awvoice-phoned=y
CONFIG_PACKAGE_luci-app-awvoice=y
# Dial tool: select the Tom-customised quectel-CM-5G-M (the CM variant the
# qmodem feed actually ships). Without choosing a CM variant, `make defconfig`
# drops qmodem entirely - its quectel-CM dependency is otherwise unmet (the
# other choices quectel-CM-5G / quectel-cm do not exist in this feed).
CONFIG_PACKAGE_luci-app-qmodem_USE_TOM_CUSTOMIZED_QUECTEL_CM=y
CONFIG_PACKAGE_quectel-CM-5G-M=y
# CONFIG_PACKAGE_luci-app-qmodem_INCLUDE_generic-qmi-wwan is not set
# Keep the qmodem-specific mwan OUT (it hijacks routing via qmodem). Plain mwan3
# (enhancements section below, DISABLED by default) is used for multi-WAN instead.
# CONFIG_PACKAGE_luci-app-qmodem-mwan is not set
# QModem extras: TTL fix (normalises forwarded-packet TTL so the carrier cannot
# detect tethering/hotspot use) + SMS web UI. Use the FIREWALL4/nftables variant
# (qmodem-ttlfw4): this firmware runs fw4/nftables, so the iptables variant
# (qmodem-ttl) writes /etc/firewall.d/ rules that fw4 never applies (TTL never
# takes effect). They ship the same /etc/config/qmodem_ttl + init (mutually
# exclusive); ttlfw4 installs an /etc/nftables.d/ rule that fw4 does apply.
# CONFIG_PACKAGE_luci-app-qmodem-ttl is not set
CONFIG_PACKAGE_luci-app-qmodem-ttlfw4=y
CONFIG_PACKAGE_luci-app-qmodem-sms=y

# ── System utilities ─────────────────────────────────────────────────────────
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_e2fsprogs=y
# USB mass-storage driver + common filesystems - without kmod-usb-storage the
# block-mount/ext4 tools above are dead (a USB drive is never detected).
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_dosfstools=y
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_exfat-fsck=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y

# ── Media / DLNA ──────────────────────────────────────────────────────────────
# miniDLNA (ReadyMedia) - UPnP-AV / DLNA media server. Streams video/music/photos
# off the auto-mounted USB storage (/mnt) to DLNA clients on the LAN: smart TVs
# (Samsung/LG/Sony), VLC, Kodi, phone apps (BubbleUPnP), PS4, Xbox. NOTE: the PS5
# has no native DLNA player, so it is not a direct client. Ships DISABLED
# (files/etc/config/minidlna enabled '0') - enable in LuCI once a drive with
# media is plugged in; the block hotplug rescan
# (files/etc/hotplug.d/block/99-cw-usb-services)
# that re-indexes on mount since miniDLNA's inotify does not catch a bulk mount.
# Any USB drive auto-mounts under /mnt and is served. LAN-only (br-lan, port
# 8200). Pulls the small AUDIO-only ffmpeg variant
# (libffmpeg-audio-dec ~1.7M, NOT the 13M libffmpeg-full) plus flac/vorbis/
# id3tag/exif for format decoding + tag/cover metadata.
CONFIG_PACKAGE_minidlna=y
CONFIG_PACKAGE_luci-app-minidlna=y

# ── NAS / file services / downloads (opt-in, pointed at USB /mnt) ─────────────
# Turn the router into a small NAS/download box. All ship INSTALLED BUT DISABLED
# (files/etc/config/* enabled '0'; the LuCI Enable box is the only switch):
# nothing listens until you enable it. Shipped defaults point at the
# auto-mounted USB storage (/mnt); set the service's credentials before enabling.
#   samba4    = SMB/CIFS file sharing of /mnt (Windows/macOS/Linux). userspace,
#               max client compatibility (the router has RAM headroom for it).
#   qBittorrent = torrent/download client (qbittorrent-nox headless, WebUI
#               on :8080), part of the image (the Qt6 stack adds ~25 MiB; the
#               image therefore needs the expanded MTD layout).
#               Ships off; the LuCI Enable box is the switch.
#   transmission = NOT in the default build (redundant with qBittorrent;
#               install it from the official packages feed if you prefer its
#               UI - `apk add transmission-daemon transmission-web luci-app-transmission`).
#   filemanager  = full-featured web file manager (browse/edit/upload + hex
#                  editor). luci-app-filebrowser is a cramped FileUpload widget;
#                  luci-app-filemanager is a proper full-page manager.
#   syncthing = P2P folder sync (phone/PC <-> /mnt) - own web UI :8384; the
#               LuCI switch is luci-app-syncthing.
#   p910nd    = USB printer share (auto-detects a plugged printer).
CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_qbittorrent=y
CONFIG_PACKAGE_luci-app-qbittorrent=y
CONFIG_PACKAGE_luci-app-samba4=y
# hd-idle - USB HDD spindown timer (NAS users). Ships DISABLED; enable in
# LuCI -> Services -> HDD idle and set the spindown time. No listening
# service, no security surface.
CONFIG_PACKAGE_hd-idle=y
CONFIG_PACKAGE_luci-app-hd-idle=y
# diskman - disk/partition manager UI (LuCI -> Services -> Disk Manager; menu title "Disk Man" renamed and moved by the patches/feeds/diskman/ patch): partition
# tables (GPT/MBR), format ext4/FAT32/exFAT/NTFS/btrfs, SMART health. NOT in
# the pinned luci feed (upstream removed it); ships from the pinned
# third-party feed in feeds.conf.default (AGPL-3.0). Destructive
# ops are user-initiated only (the smartd daemon is not part of the image).
# Diskman mounts are live-only - boot mounts
# stay with LuCI -> System -> Mount Points.
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-filemanager=y
CONFIG_PACKAGE_syncthing=y
# luci-app-syncthing: the LuCI on/off switch (cwfeed, original CleanWRT code)
CONFIG_PACKAGE_luci-app-syncthing=y
CONFIG_PACKAGE_p910nd=y
CONFIG_PACKAGE_luci-app-p910nd=y

# ── Performance ──────────────────────────────────────────────────────────────
# irqbalance spreads modem/wifi/ethernet IRQs across the 4 cores (throughput).
# BBR congestion control suits high-latency cellular (enabled via the
# files/etc/sysctl.d overlay).
CONFIG_PACKAGE_irqbalance=y
CONFIG_PACKAGE_kmod-tcp-bbr=y

# ── Multi-WAN (plain mwan3, DISABLED by default) ─────────────────────────────
# Failover/load-balance the 5G modem against a backup WAN (USB tether / USB
# modem / USB ethernet - see the tethering drivers above).
# mwan3 + luci-app-mwan3: REMOVED from the default build. Install from the packages feed when you actually need multi-WAN:
#   apk add mwan3 luci-app-mwan3

# ── Data-usage history (metered 5G) ──────────────────────────────────────────
CONFIG_PACKAGE_vnstat2=y
CONFIG_PACKAGE_luci-app-vnstat2=y

# ── CGNAT-busting remote access (5G hands out a CGNAT IP - no port-forward) ───
# tailscale = mesh VPN (reach the LAN from anywhere) - LuCI UI + CLI `tailscale up`.
# cloudflared = Cloudflare Tunnel (expose a service, no public IP) - LuCI UI.
# (frpc/pbr intentionally NOT shipped - frpc's own-VPS tunnel is covered by
# tailscale+cloudflared; policy-routing is not core to this build.)
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_luci-app-tailscale-community=y
CONFIG_PACKAGE_cloudflared=y
CONFIG_PACKAGE_luci-app-cloudflared=y

# ── Watchcat ─────────────────────────────────────
# Connectivity watchdog (reboot / restart interface / run script). Ships with NO
# rule: the package default is an active "ping 8.8.8.8, reboot after 6h" rule, so
# files/etc/config/watchcat replaces it with an empty config; you add a rule
# in LuCI (Services > Watchcat). The modem still self-recovers natively.
CONFIG_PACKAGE_watchcat=y
CONFIG_PACKAGE_luci-app-watchcat=y

# ── Diagnostics ────────────────────────────────────────────
CONFIG_PACKAGE_ethtool-full=y
CONFIG_PACKAGE_mtr-json=y
CONFIG_PACKAGE_iperf3=y

# ── IPv6 ─────────────────────────────────────────────────────────────────────
CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y
CONFIG_PACKAGE_kmod-ip6tables=y
