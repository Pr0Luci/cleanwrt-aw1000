# Out-of-feed packages, cloned into <openwrt-tree>/package/<name> at a pinned commit.
# Used for packages whose repository is not a feed. Applied by tools/cw-release-build.sh;
# the commit is verified after checkout, so the build fails rather than silently using
# a different one.
#
# Format (whitespace-separated, one package per line):  <name> <git-url> <commit-sha>
#
# Repositories that keep the package in a <name>/ subdirectory (feed layout) are
# installed from that subdirectory; ones with the Makefile at the repo root as a whole.

# luci-app-cw-led: front-panel LED daemon and LuCI page, GPL-2.0-only
luci-app-cw-led https://github.com/Pr0Luci/luci-app-cw-led.git ee7b5f8861f1c247868207ccbff6b65c988783ce
# LuCI themes. Three third-party themes ship so the web UI can be compared on the
# device; each keeps its own package, licence file and pin. None of them is merged
# into CleanWRT code.
#
# luci-theme-footstrap: the default theme (files/etc/uci-defaults/96-cw-default-theme).
# Apache-2.0; the package builds its CSS with cat and awk only, so no node toolchain
# enters the builder image. Pinned at the commit tag v0.14.20 points to.
luci-theme-footstrap https://github.com/VizzleTF/luci-theme-footstrap.git a1711eda02fefe87a12590bae9eaa80c373a4bd9
# luci-theme-argon: Apache-2.0, ucode templates (the 25.12 theme mechanism).
# Pinned at the commit tag v3.1.2 points to.
luci-theme-argon https://github.com/jerrykuku/luci-theme-argon.git 7b77b44b8324ba4939144760ed3f09c1a1d1e833
# luci-theme-alpha: Apache-2.0, still the luasrc (Lua templates) layout. Selected so
# it can be checked on the device; if it does not render on 25.12 it comes back out.
# Pinned at the newest published release tag 3.9.7-beta2.
luci-theme-alpha https://github.com/derisamedia/luci-theme-alpha.git aed1071054ecc3fdb0cc2368c68197a906f9946a

# luci-app-homeproxy: HomeProxy LuCI app (ImmortalWrt), another proxy app on the same
# cores the image already ships (sing-box). Single-package repo with the Makefile at
# the root, so a local pin and not a feed. Ships DISABLED.
luci-app-homeproxy https://github.com/immortalwrt/homeproxy.git 98a6ad9e71484528008ff435694fd107591f3a1d

# AWvoice: the RJ11 phone port (feed-layout repo; the three packages live at the
# repository root). GPL-2.0-only, the board configuration data file included.
# Pinned at the commit that carries version 1.1.3 of all three packages: the SIP
# side of the phone port - the switch that starts and stops the LAN service this
# image now ships, the account a soft phone signs in with, the web phone - and the
# code a phone scans: the phone daemon writes that file into a folder of its own,
# keeps it only for the lifetime the page promises, and
# files/etc/uci-defaults/49-cw-awvoice-provision-port opens the listener that
# serves it. The three packages share one version, so they share one pin.
kmod-awvoice-fxs https://github.com/Pr0Luci/openwrt-aw1000-voice-awvoice.git 94f310d8fe269d178bac59df0ab6da3c959a18dc
awvoice-phoned https://github.com/Pr0Luci/openwrt-aw1000-voice-awvoice.git 94f310d8fe269d178bac59df0ab6da3c959a18dc
luci-app-awvoice https://github.com/Pr0Luci/openwrt-aw1000-voice-awvoice.git 94f310d8fe269d178bac59df0ab6da3c959a18dc
