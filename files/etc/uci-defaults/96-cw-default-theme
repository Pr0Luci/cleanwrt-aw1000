#!/bin/sh
# Set the default LuCI theme - and repair one this image no longer carries.
#
# uci-defaults run again after a sysupgrade, so this script must not clobber a
# theme the user picked. It therefore changes mediaurlbase in three cases only:
#   - nothing is set, or the stock bootstrap default is still in place;
#   - the value already names the theme this image ships (nothing to do);
#   - the value names a theme whose directory is gone from the image: a dangling
#     base renders a blank web page, so it is repaired to the shipped default.
# The theme directory must exist before anything points at it: a pin that failed
# to install must leave the working bootstrap in place rather than break the UI.
[ -f /etc/config/luci ] || exit 0

want='footstrap'
base="/luci-static/$want"
[ -d "/www$base" ] || exit 0

cur=$(uci -q get luci.main.mediaurlbase)
need=0
case "$cur" in
	''|/luci-static/bootstrap)	need=1 ;;
	"$base")			need=0 ;;
	*)	[ -d "/www$cur" ] || need=1 ;;
esac
[ "$need" = 1 ] || {
	# already right, or the user's own choice and still installed
	uci -q delete luci.cw_state && uci commit luci
	exit 0
}

# Footstrap registers its own theme entry; naming it here keeps the switch working
# even if that registration is deferred to a later first-boot script.
uci set "luci.themes.Footstrap=$base"
uci set "luci.main.mediaurlbase=$base"
# A marker left by an older image is dead state: the choice is read from the theme
# directory itself.
uci -q delete luci.cw_state
uci commit luci
logger -t cw-firstboot "luci: default theme set to Footstrap"
exit 0
