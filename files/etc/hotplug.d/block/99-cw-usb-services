#!/bin/sh
# Restart USB-backed services when a drive partition mounts/unmounts so they pick
# up the freshly-mounted /mnt drive:
#   - miniDLNA re-indexes (its inotify does not catch a bulk mount: the files
#     already exist at mount time, so no IN_CREATE events fire).
# Runs after /etc/hotplug.d/block/10-mount (lower prefix) so the mount is in
# place. Only reacts to USB partitions (sda1, sdb1, …).
case "$ACTION" in add|remove) ;; *) exit 0 ;; esac
case "$DEVNAME" in sd*[0-9]) ;; *) exit 0 ;; esac

(
    sleep 5                                              # let block-mount finish
    # Serialize concurrent mount events (two partitions = two hotplug runs);
    # a second event while one is in flight is dropped - the restarts it
    # would trigger just happened anyway.
    lock="/var/run/cw-usb-services.lock"
    mkdir "$lock" 2>/dev/null || exit 0
    if [ "$(uci -q get minidlna.config.enabled)" = "1" ]; then
        db="$(uci -q get minidlna.config.db_dir)"
        # rm -rf guard: the cache dir must live under a scratch root - never
        # wipe an arbitrary path someone set as db_dir.
        case "${db:-/var/run/minidlna}" in
            /var/run/*|/tmp/*) : ;;
            *) db=/var/run/minidlna ;;
        esac
        /etc/init.d/minidlna stop
        d="${db%/}"
        rm -rf "${d:?}"/* 2>/dev/null                    # drop cache -> full re-index
        /etc/init.d/minidlna start
    fi
    rmdir "$lock" 2>/dev/null
) >/dev/null 2>&1 &
exit 0
