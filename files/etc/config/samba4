config samba
	option workgroup 'WORKGROUP'
	option charset 'UTF-8'
	option description 'CleanWRT NAS'
	option enable_extra_tuning '1'

# Share the auto-mounted USB storage (/mnt -> any drive shows up as a subfolder).
# PUBLIC-RELEASE posture: guest access is OFF. The samba4 init script has no
# 'enabled' option, so the service itself always starts; with guest_ok 'no' and
# no user accounts configured the share is unreachable until you set up
# users/permissions in LuCI -> Network -> Filesystem Share (or flips guest_ok).
config sambashare
	option name 'USB'
	option path '/mnt'
	option read_only 'no'
	option guest_ok 'no'
	option inherit_owner 'yes'
	option create_mask '0666'
	option dir_mask '0777'
	option force_root '1'
