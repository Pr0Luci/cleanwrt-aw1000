# Adblock ships OFF (opt-in). Same defaults as the package
# (adblock 4.5.x) except adb_enabled: the DNS blocker filters all name
# resolution, so it only runs once you tick Enabled in LuCI
# (Services > Adblock). The init stays enabled and the script exits at once
# while adb_enabled is 0, so the LuCI checkbox is the only switch.

config adblock 'global'
	option adb_enabled '0'
	option adb_debug '0'
	option adb_nftforce '0'
	option adb_dnsshift '0'
	option adb_safesearch '0'
	option adb_mail '0'
	option adb_report '0'
	list adb_feed 'adguard'
	list adb_feed 'adguard_tracking'
	list adb_feed 'certpl'
