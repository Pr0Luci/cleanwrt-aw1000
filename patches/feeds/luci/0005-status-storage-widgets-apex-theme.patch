+/* CleanWRT: the Apex theme (luci-theme-apex) shows this card as widgets; every
+   other theme keeps the stock table below, unchanged. The theme is read on every
+   render from L.env.media (set by the luci-base header template). The ax-sys-* /
+   ax-mem-* classes are styled by the theme's cascade.css. */
+function isApexTheme() {
+	var media = String(L.env.media || '').replace(/\/+$/, '');
+
+	return media.slice(media.lastIndexOf('/') + 1) === 'apex';
+}
+
+function apexIcon(paths) {
+	return E('<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" ' +
+		'stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" ' +
+		'focusable="false">' + paths + '</svg>');
+}
+
+/* header (icon, title, percentage), value / total, meter */
+function apexHead(id, icon, title, value, total) {
+	var pct = Math.floor(100 / total * value),
+	    frac = Math.max(0, Math.min(100, 100 / total * value)),
+	    fv = '%1024.2mB'.format(value),
+	    ft = '%1024.2mB'.format(total);
+
+	return [
+		E('header', { 'class': 'ax-sys-top' }, [
+			E('span', { 'class': 'ax-sys-ic' }, [ apexIcon(icon) ]),
+			E('h4', { 'class': 'ax-sys-t', 'id': id }, [ title ]),
+			E('span', { 'class': 'ax-mem-pct' }, [ '%d%%'.format(pct) ])
+		]),
+		E('p', { 'class': 'ax-mem-big' }, [
+			E('strong', {}, [ fv ]),
+			E('span', {}, [ '/ ' + ft ])
+		]),
+		E('span', {
+			'class': 'ax-sys-bar',
+			'role': 'meter',
+			'aria-labelledby': id,
+			'aria-valuemin': 0,
+			'aria-valuemax': total,
+			'aria-valuenow': value,
+			'aria-valuetext': '%s / %s (%d%%)'.format(fv, ft, pct)
+		}, [ E('i', { 'style': 'width:%.2f%%'.format(frac) }) ])
+	];
+}
+
+function apexStorageWidget(id, icon, title, used, size, mount) {
+	var free = Math.max(0, size - used);
+
+	return E('section', { 'class': 'ax-sys-w ax-mem-w', 'aria-labelledby': id },
+		apexHead(id, icon, title, used, size).concat([
+			E('dl', { 'class': 'ax-mem-stats' }, [
+				[ _('Used'), used ], [ _('Free'), free ], [ _('Total'), size ]
+			].map(function(p) {
+				return E('div', {}, [ E('dt', {}, [ p[0] ]), E('dd', {}, [ '%1024.2mB'.format(p[1]) ]) ]);
+			})),
+			mount ? E('p', { 'class': 'ax-mem-mnt' }, [ E('i', { 'aria-hidden': 'true' }), mount ]) : ''
+		]));
+}
+
+/* "mount point · device", e.g. "/tmp · tmpfs" */
+function apexMountLabel(mounts, wanted) {
+	for (var i = 0; i < wanted.length; i++)
+		for (var j = 0; j < mounts.length; j++)
+			if (mounts[j].mount == wanted[i])
+				return '%s · %s'.format(mounts[j].mount, mounts[j].device);
+
+	return null;
+}
+
+function renderApexStorage(root, tmp, mounts, skip) {
+	var list = Array.isArray(mounts) ? mounts : [],
+	    items = [];
+
+	if (root.total > 0)
+		items.push([ 'ax-st-root', '<rect x="3" y="5" width="18" height="14" rx="1"/><path d="M3 14h18M7 17h.01M11 17h.01"/>',
+			_('Disk space'), root.used * 1024, root.total * 1024, apexMountLabel(list, [ '/overlay', '/' ]) ]);
+
+	if (tmp.total > 0)
+		items.push([ 'ax-st-tmp', '<path d="M5 4h14v6H5zM5 10v10h14V10"/><path d="M9 14h6"/>',
+			_('Temp space'), tmp.used * 1024, tmp.total * 1024, apexMountLabel(list, [ '/tmp' ]) ]);
+
+	list.forEach(function(entry, i) {
+		if (skip.includes(entry.mount) || !(entry.size > 0))
+			return;
+
+		items.push([ 'ax-st-m' + i, '<rect x="3" y="5" width="18" height="14" rx="1"/><path d="M3 14h18M7 17h.01M11 17h.01"/>',
+			entry.device + ' (' + entry.mount + ')', entry.size - entry.free, entry.size,
+			'%s · %s'.format(entry.mount, entry.device) ]);
+	});
+
+	return items.length ? E('div', { 'class': 'ax-mem' }, items.map(function(i) {
+		return apexStorageWidget(i[0], i[1], i[2], i[3], i[4], i[5]);
+	})) : null;
+}
+
