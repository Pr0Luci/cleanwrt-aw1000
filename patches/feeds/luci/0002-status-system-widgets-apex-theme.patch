--- a/modules/luci-mod-status/htdocs/luci-static/resources/view/status/include/10_system.js
+++ b/modules/luci-mod-status/htdocs/luci-static/resources/view/status/include/10_system.js
@@ -25,6 +25,150 @@ var callSystemInfo = rpc.declare({
 	method: 'info'
 });
 
+/* CleanWRT: the Apex theme (luci-theme-apex) shows this card as grouped
+   widgets. Every other theme keeps the stock table below, unchanged. The
+   theme is read on every render from L.env.media (set by the core header
+   template), so switching themes needs no reload logic here. The ax-sys-*
+   classes are styled by the theme's cascade.css. */
+var apexCpuCount = null;
+
+function isApexTheme() {
+	var media = String(L.env.media || '').replace(/\/+$/, '');
+
+	return media.slice(media.lastIndexOf('/') + 1) === 'apex';
+}
+
+/* CPU count from the kernel's "online" list ("0-3", "0,2-3", ...) */
+function parseCpuList(list) {
+	var n = 0;
+
+	String(list || '').trim().split(',').forEach(function(part) {
+		var m = part.match(/^(\d+)(?:-(\d+))?$/);
+
+		if (m)
+			n += m[2] ? (+m[2] - +m[1] + 1) : 1;
+	});
+
+	return n;
+}
+
+/* "YYYY-MM-DD HH:MM:SS" in the router's configured time zone (the stock card
+   uses a locale-dependent long format); the system "hour cycle" setting is
+   honoured (AM/PM kept in 12 h modes), the default is 24 h. Latin digits
+   regardless of the browser locale. */
+function apexDateTime(unixtime, zone, hourcycle) {
+	var p = {};
+
+	new Intl.DateTimeFormat('en-US', {
+		year: 'numeric', month: '2-digit', day: '2-digit',
+		hour: '2-digit', minute: '2-digit', second: '2-digit',
+		hourCycle: hourcycle || 'h23',
+		timeZone: zone
+	}).formatToParts(new Date(unixtime * 1000)).forEach(function(part) {
+		p[part.type] = part.value;
+	});
+
+	return '%s-%s-%s %s:%s:%s'.format(p.year, p.month, p.day, p.hour, p.minute, p.second) +
+		(p.dayPeriod ? ' ' + p.dayPeriod : '');
+}
+
+function apexIcon(paths) {
+	return E('<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" ' +
+		'stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" ' +
+		'focusable="false">' + paths + '</svg>');
+}
+
+function apexWidget(id, icon, title, body) {
+	return E('section', { 'class': 'ax-sys-w', 'aria-labelledby': id }, [
+		E('header', { 'class': 'ax-sys-top' }, [
+			E('span', { 'class': 'ax-sys-ic' }, [ apexIcon(icon) ]),
+			E('h4', { 'class': 'ax-sys-t', 'id': id }, [ title ])
+		]),
+		body
+	]);
+}
+
+function apexRows(pairs) {
+	return E('dl', { 'class': 'ax-sys-dl' }, pairs.map(function(p) {
+		return E('div', { 'class': 'ax-sys-r' }, [
+			E('dt', {}, [ p[0] ]),
+			E('dd', {}, [ (p[1] != null && p[1] !== '') ? p[1] : '?' ])
+		]);
+	}));
+}
+
+function apexUptime(seconds) {
+	return _('%dd %02dh %02dm').format(
+		Math.floor(seconds / 86400),
+		Math.floor(seconds % 86400 / 3600),
+		Math.floor(seconds % 3600 / 60));
+}
+
+/* the bar is the load per CPU (1.00 = every core busy), clamped to the track;
+   the exact load is always shown as text */
+function apexLoadRow(label, load, cpus) {
+	var pct = Math.round(Math.min(1, load / cpus) * 100);
+
+	return E('li', { 'class': 'ax-sys-lr' }, [
+		E('span', { 'class': 'ax-sys-lk' }, [ label ]),
+		E('span', {
+			'class': 'ax-sys-bar',
+			'role': 'meter',
+			'aria-label': _('Load average, %s').format(label),
+			'aria-valuemin': 0,
+			'aria-valuemax': 100,
+			'aria-valuenow': pct,
+			'aria-valuetext': _('%.2f (%d percent of CPU capacity)').format(load, pct)
+		}, [ E('i', { 'style': 'width:%d%%'.format(pct) }) ]),
+		E('b', { 'class': 'ax-sys-lv' }, [ '%.2f'.format(load) ])
+	]);
+}
+
+function renderApexWidgets(v) {
+	var load = Array.isArray(v.systeminfo.load) ? v.systeminfo.load.map(function(l) {
+		return l / 65535.0;
+	}) : null;
+
+	return E('div', { 'class': 'ax-sys' }, [
+		E('div', { 'class': 'ax-sys-row' }, [
+			apexWidget('ax-sys-hw',
+				'<rect x="4" y="4" width="16" height="16" rx="1"/><path d="M9 9h6v6H9zM9 2v2M15 2v2M9 20v2M15 20v2M2 9h2M2 15h2M20 9h2M20 15h2"/>',
+				_('Hardware'), apexRows([
+					[ _('Hostname'),        v.boardinfo.hostname ],
+					[ _('Model'),           v.boardinfo.model ],
+					[ _('Architecture'),    v.boardinfo.system ],
+					[ _('Target Platform'), L.isObject(v.boardinfo.release) ? v.boardinfo.release.target : '' ]
+				])),
+			apexWidget('ax-sys-sw',
+				'<path d="M8 6l-5 6 5 6M16 6l5 6-5 6"/>',
+				_('Software'), apexRows([
+					[ _('Firmware Version'), L.isObject(v.boardinfo.release) ? v.boardinfo.release.description : '' ],
+					[ _('LuCI'),             v.lucirevision ],
+					[ _('Kernel Version'),   v.boardinfo.kernel ]
+				]))
+		]),
+		E('div', { 'class': 'ax-sys-row' }, [
+			apexWidget('ax-sys-tm',
+				'<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
+				_('Time'), E([
+					E('p', { 'class': 'ax-sys-up' }, [
+						E('strong', {}, [ v.systeminfo.uptime ? apexUptime(v.systeminfo.uptime) : '?' ]),
+						' ',
+						E('span', {}, [ _('uptime') ])
+					]),
+					apexRows([ [ _('Local Time'), v.datestr ] ])
+				])),
+			apexWidget('ax-sys-ld',
+				'<path d="M4 20V9M10 20V4M16 20v-8M22 20H2"/>',
+				_('Load Average'), load ? E('ul', { 'class': 'ax-sys-ld' }, [
+					apexLoadRow(_('1 min'),  load[0], v.cpus),
+					apexLoadRow(_('5 min'),  load[1], v.cpus),
+					apexLoadRow(_('15 min'), load[2], v.cpus)
+				]) : E('p', { 'class': 'ax-sys-na' }, [ '?' ]))
+		])
+	]);
+}
+
