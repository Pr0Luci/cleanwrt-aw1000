qmodem_sipd: the inbound credential is taken from the config

The consumer authenticated with the ha1 held in /var/run/qmodem_voip/sip.conf, and only the
ubus method qmodem_voip_sip_credentials_generate ever wrote that file. A password set in the
config was read by the validator - which requires one before a direction will start - but never
reached the credential file, so the phones kept authenticating against whatever the file already
held. The file lives on tmpfs, so after a reboot there was nothing to read and the inbound
consumer returned 2 until procd's respawn ran out.

qmodem_voip_sip_credentials_sync() reads the config's inbound username and password and
rewrites that file. It is defined in this package and called nowhere.

Call it before the credential is loaded at start, and again on the reload signal beside the
load that already happens there, so the config is the record and the file is derived state. A
sync that fails says so once and leaves the file as it is: a credential written by hand keeps
working, and the load that follows still decides whether this endpoint starts. The consumer now
compiles sip_credentials.c and links libuci for it.

diff --git a/application/qmodem_sipd/Makefile b/application/qmodem_sipd/Makefile
index 6317232..a8fe112 100644
--- a/application/qmodem_sipd/Makefile
+++ b/application/qmodem_sipd/Makefile
@@ -42,9 +42,10 @@ define Build/Compile
 		-o $(PKG_BUILD_DIR)/qmodem_voip_sip_consumer \
 		$(PKG_BUILD_DIR)/sip_consumer.c $(PKG_BUILD_DIR)/sip_gateway.c \
 		$(PKG_BUILD_DIR)/sip_activation.c $(PKG_BUILD_DIR)/media_socket_client.c \
+		$(PKG_BUILD_DIR)/sip_credentials.c \
 		$(TARGET_LDFLAGS) \
 		-lpjsip -lpjsip-ua -lpjlib-util -lpj -lsoxr -lasound \
-		-lubus -lubox -lblobmsg_json -ljson-c -lm
+		-lubus -lubox -lblobmsg_json -ljson-c -luci -lm
 	$(TARGET_CC) $(TARGET_CPPFLAGS) $(TARGET_CFLAGS) \
 		-I$(STAGING_DIR)/usr/include -Wall -Wextra -Werror -std=gnu11 \
 		-o $(PKG_BUILD_DIR)/qmodem_voip_sipd \
diff --git a/application/qmodem_sipd/src/sip_consumer.c b/application/qmodem_sipd/src/sip_consumer.c
index 5bf3a64..bbdac87 100644
--- a/application/qmodem_sipd/src/sip_consumer.c
+++ b/application/qmodem_sipd/src/sip_consumer.c
@@ -20,6 +20,7 @@
 
 #include "sip_gateway.h"
 #include "sip_activation.h"
+#include "sip_credentials.h"
 #include "g711.h"
 #include "media_socket_client.h"
 #include "rtp_transport.h"
@@ -1862,6 +1863,19 @@ static void consumer_event(struct ubus_context *context,
 		send_incoming_invite();
 }
 
+/* the config holds what was set there, the credential file holds what this endpoint authenticates with, and
+ * nothing linked them: a password written to the config never reached the file, so the phones kept answering
+ * to the ha1 the file already held.  The sync this package ships reads the config's inbound username and
+ * password and rewrites that file; a failure leaves the file untouched, so a credential put there by hand
+ * keeps working and the load below still decides whether this endpoint can start. */
+static void sync_credentials(void)
+{
+	char username[QMODEM_VOIP_SIP_USERNAME_SIZE] = { 0 };
+
+	if (qmodem_voip_sip_credentials_sync(username) != 0)
+		syslog(LOG_WARNING, "qmodem_voip sip: inbound credentials unusable, keeping the file as it is");
+}
+
 static int load_credentials(void)
 {
 	struct qmodem_voip_sip_credentials credentials;
@@ -2001,8 +2015,11 @@ int main(int argc, char **argv)
 	app.rtp_fd = -1;
 	app.media_attach_timeout.cb = media_attach_retry;
 	app.media_revision = (uint64_t)time(NULL);
-	if (!app.outbound && load_credentials() != 0) {
-		return 2;
+	if (!app.outbound) {
+		sync_credentials();
+		if (load_credentials() != 0) {
+			return 2;
+		}
 	}
 	(void)strcpy(app.lan_address, argv[4]);
 	(void)snprintf(app.media_socket_path, sizeof(app.media_socket_path), "%s", argv[6]);
@@ -2103,8 +2120,10 @@ int main(int argc, char **argv)
 		if (app.reload_requested) {
 			app.reload_requested = 0;
 			uloop_timeout_cancel(&app.media_attach_timeout);
-			if (!app.outbound)
+			if (!app.outbound) {
+				sync_credentials();
 				(void)load_credentials();
+			}
 			app.binding[0] = '\0';
 			app.expires = 0;
 			qmodem_voip_sip_call_release(&app.call);
