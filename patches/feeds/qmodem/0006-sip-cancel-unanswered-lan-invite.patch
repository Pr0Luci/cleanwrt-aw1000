 		{ .name = "remote_number", .type = BLOBMSG_TYPE_STRING },
-		{ .name = "caller_id_withheld", .type = BLOBMSG_TYPE_UNSPEC }
+		{ .name = "caller_id_withheld", .type = BLOBMSG_TYPE_UNSPEC },
+		{ .name = "answer_owner", .type = BLOBMSG_TYPE_STRING }
