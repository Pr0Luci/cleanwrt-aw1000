 		}
+		if (app.call.origin == QMODEM_VOIP_SIP_CALL_CELLULAR && values[5] &&
+		    strcmp(blobmsg_get_string(values[5]), "sip") != 0)
+			cancel_lan_invite();
 	} else if (strcmp(blobmsg_get_string(values[0]), "release") == 0) {
 		app.incoming_number[0] = '\0';
 		app.incoming_caller_id_withheld = 0;
