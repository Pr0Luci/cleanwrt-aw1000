+	if (status >= 300 && app.lan_cancelling) {
+		/* RFC 3261 9.2: the UAC that sent CANCEL expects the INVITE's final response to be 487 (RFC 6026 8) and
+		 * treats the transaction as cancelled; it is not a failure of the call, which was taken elsewhere */
+		app.lan_cancelling = 0;
+		return PJ_FALSE;
+	}
