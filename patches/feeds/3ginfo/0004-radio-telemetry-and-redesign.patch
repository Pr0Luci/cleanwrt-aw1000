diff --git a/luci-app-3ginfo-lite/tests/collector.sh b/luci-app-3ginfo-lite/tests/collector.sh
new file mode 100755
index 0000000..9247e4f
--- /dev/null
+++ b/luci-app-3ginfo-lite/tests/collector.sh
@@ -0,0 +1,160 @@
+#!/bin/sh
+# Offline checks for radiodata.sh's cache, rate limits, locking and fallback.
+#
+# The modem is replaced by a tiny fake ubus, so this runs on a laptop and never
+# touches a router. Run from the package directory: sh tests/collector.sh
+# GPL-3.0. Part of luci-app-3ginfo-lite.
+
+set -eu
+
+ROOT=$(cd "$(dirname "$0")/.." && pwd)
+RES="$ROOT/root/usr/share/3ginfo-lite"
+FIX="$ROOT/tests/fixtures"
+TMP=$(mktemp -d /tmp/3ginfo-collector.XXXXXX)
+trap 'rm -rf "$TMP"' EXIT INT TERM
+
+fail() {
+	echo "FAIL: $1" >&2
+	exit 1
+}
+
+check() {
+	[ "$2" = "$3" ] || fail "$1 (expected '$3', got '$2')"
+}
+
+mode_of() {
+	stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1" 2>/dev/null || echo unknown
+}
+
+mkdir -p "$TMP/bin" "$TMP/legacy-bin" "$TMP/fixtures" "$TMP/legacy-res"
+cp "$FIX/qmodem/base.json" "$FIX/qmodem/cell_endc.json" "$FIX/qmodem/band_endc.json" \
+	"$FIX/qmodem/sim.json" "$FIX/qmodem/iface.json" "$FIX/qmodem/qca.txt" \
+	"$FIX/qmodem/neighbors.json" "$TMP/fixtures/"
+cp "$FIX/legacy/lte_ca.json" "$TMP/fixtures/legacy.json"
+
+cat > "$TMP/bin/timeout" <<'EOS'
+#!/bin/sh
+shift
+exec "$@"
+EOS
+cat > "$TMP/bin/uci" <<'EOS'
+#!/bin/sh
+case "$*" in
+	"-q get 3ginfo.@3ginfo[0].network") echo wwan0 ;;
+	"-q get network.wwan0.modem_config") echo 4_1 ;;
+	"-q get qmodem.4_1.at_port") echo /dev/ttyUSB3 ;;
+	"-q get qmodem.4_1.use_ubus") echo 1 ;;
+	"-q get 3ginfo.@3ginfo[0].radio_neighbor_interval") echo 60 ;;
+	"show network") echo "network.wwan0.modem_config='4_1'" ;;
+	"show qmodem") echo "qmodem.4_1=modem-device" ;;
+	*) exit 1 ;;
+esac
+EOS
+cat > "$TMP/bin/ifstatus" <<'EOS'
+#!/bin/sh
+cat "$FIXTURE_DIR/iface.json"
+EOS
+cat > "$TMP/bin/ubus" <<'EOS'
+#!/bin/sh
+if [ "$1" = "-v" ] && [ "$2" = "list" ]; then
+	echo '"send_at":{}'
+	echo '"get_neighborcell":{}'
+	exit 0
+fi
+if [ "$1" = "-t" ]; then shift 2; fi
+case "$1" in
+	list) echo qmodem ;;
+	call)
+		case "$3" in
+			base_info) cat "$FIXTURE_DIR/base.json" ;;
+			cell_info) cat "$FIXTURE_DIR/cell_endc.json" ;;
+			get_current_band) cat "$FIXTURE_DIR/band_endc.json" ;;
+			sim_info) cat "$FIXTURE_DIR/sim.json" ;;
+			send_at) jq -n --rawfile r "$FIXTURE_DIR/qca.txt" '{at_cfg:{status:"1",res:$r}}' ;;
+			get_neighborcell) cat "$FIXTURE_DIR/neighbors.json" ;;
+			*) echo '{}' ;;
+		esac
+		;;
+	*) exit 1 ;;
+esac
+EOS
+cp "$TMP/bin/timeout" "$TMP/bin/uci" "$TMP/bin/ifstatus" "$TMP/legacy-bin/"
+chmod +x "$TMP/bin/"* "$TMP/legacy-bin/"*
+
+FIXTURE_DIR="$TMP/fixtures"
+export FIXTURE_DIR
+# Whole-second lock waits are fine on a router but slow a laptop test down.
+export RADIO_LOCK_WAIT=1
+
+# The legacy tree deliberately has no ubus, so the collector must take the
+# 3ginfo.sh path and say so.
+cp "$RES/radiodata.sh" "$RES/radio-normalize.jq" "$RES/radio-qca.awk" \
+	"$RES/radio-neighbors.jq" "$RES/mccmnc.dat" "$TMP/legacy-res/"
+cat > "$TMP/legacy-res/3ginfo.sh" <<EOS
+#!/bin/sh
+cat "$FIXTURE_DIR/legacy.json"
+EOS
+
+export PATH="$TMP/bin:$PATH"
+export RADIO_RES="$RES"
+export RADIO_CACHE="$TMP/cache.json"
+export RADIO_ID_CACHE="$TMP/id.json"
+export RADIO_LOCKDIR="$TMP/lock"
+
+first=$(sh "$RES/radiodata.sh" json)
+check "first sample is live" "$(printf '%s' "$first" | jq -r '.meta.cached')" "false"
+check "first sample source" "$(printf '%s' "$first" | jq -r '.meta.source')" "qmodem"
+check "first sample mode" "$(printf '%s' "$first" | jq -r '.connection.mode')" "5G NSA"
+check "first sample records a duration" "$(printf '%s' "$first" | jq -r '.meta.duration_ms >= 0')" "true"
+check "first sample carriers" "$(printf '%s' "$first" | jq -r '.connection.carrier_count')" "3"
+check "first sample neighbour capability" "$(printf '%s' "$first" | jq -r '.capabilities.neighbors')" "true"
+check "snapshot is private" "$(mode_of "$TMP/cache.json")" "600"
+
+second=$(sh "$RES/radiodata.sh" json)
+check "second sample is cached" "$(printf '%s' "$second" | jq -r '.meta.cached')" "true"
+
+refresh=$(sh "$RES/radiodata.sh" refresh)
+check "refresh obeys the floor" "$(printf '%s' "$refresh" | jq -r '.meta.rate_limited')" "true"
+
+neighbours=$(sh "$RES/radiodata.sh" neighbors)
+check "neighbour LTE count" "$(printf '%s' "$neighbours" | jq -r '.neighbors.lte | length')" "2"
+check "neighbour NR count" "$(printf '%s' "$neighbours" | jq -r '.neighbors.nr | length')" "1"
+check "neighbour scan timestamp" "$(printf '%s' "$neighbours" | jq -r '.meta.neighbor_age_seconds')" "0"
+
+again=$(sh "$RES/radiodata.sh" neighbors)
+check "neighbour scan is rate limited" "$(printf '%s' "$again" | jq -r '.meta.neighbor_rate_limited')" "true"
+
+# A live pid in the lock directory must not be mistaken for a stale lock.
+mkdir "$TMP/lock"
+printf '%s\n' "$$" > "$TMP/lock/pid"
+busy=$(sh "$RES/radiodata.sh" json)
+check "lock reports a cached snapshot" "$(printf '%s' "$busy" | jq -r '.meta.busy')" "true"
+rm -rf "$TMP/lock"
+
+# A SIM whose ISP field is only the numeric MCC/MNC must resolve to a name from
+# the table this package ships (41302 -> Dialog), without a stray CR at the end.
+cp -r "$TMP/fixtures" "$TMP/fixtures-num"
+jq '.modem_info |= map(if .key == "ISP" then .value = "41302" else . end)' \
+	"$FIX/qmodem/sim.json" > "$TMP/fixtures-num/sim.json"
+FIXTURE_DIR="$TMP/fixtures-num" RADIO_CACHE="$TMP/num-cache.json" \
+	RADIO_ID_CACHE="$TMP/num-id.json" RADIO_LOCKDIR="$TMP/num-lock" \
+	sh "$RES/radiodata.sh" json > "$TMP/num.json"
+check "numeric ISP resolves through the MCC/MNC table" \
+	"$(jq -r '.connection.operator' "$TMP/num.json")" "Dialog"
+
+# Legacy fallback: no ubus on PATH, only 3ginfo.sh and its fixtures.
+export PATH="$TMP/legacy-bin:/usr/bin:/bin:/usr/sbin:/sbin"
+export RADIO_RES="$TMP/legacy-res"
+export RADIO_CACHE="$TMP/legacy-cache.json"
+export RADIO_ID_CACHE="$TMP/legacy-id.json"
+export RADIO_LOCKDIR="$TMP/legacy-lock"
+legacy=$(sh "$TMP/legacy-res/radiodata.sh" json)
+check "legacy source" "$(printf '%s' "$legacy" | jq -r '.meta.source')" "legacy"
+check "legacy mode" "$(printf '%s' "$legacy" | jq -r '.connection.mode')" "LTE-A"
+check "legacy carrier count" "$(printf '%s' "$legacy" | jq -r '.connection.carrier_count')" "2"
+check "legacy says QModem is absent" "$(printf '%s' "$legacy" | jq -r '[.meta.warnings[] | select(test("QModem was not found"))] | length')" "1"
+
+error=$(sh "$RES/radiodata.sh" nonsense || true)
+check "unknown mode is JSON" "$(printf '%s' "$error" | jq -r '.error' | cut -d: -f1)" "unknown mode"
+
+echo "PASS: collector cache, scan rate limit, locking and legacy fallback"
