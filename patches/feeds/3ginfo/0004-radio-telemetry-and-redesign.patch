 include $(TOPDIR)/feeds/luci/luci.mk
 
diff --git a/luci-app-3ginfo-lite/htdocs/luci-static/resources/3ginfo/radio.css b/luci-app-3ginfo-lite/htdocs/luci-static/resources/3ginfo/radio.css
new file mode 100644
index 0000000..d44e8f2
--- /dev/null
+++ b/luci-app-3ginfo-lite/htdocs/luci-static/resources/3ginfo/radio.css
@@ -0,0 +1,821 @@
+/*
+ * 3gInfo-lite radio view.
+ *
+ * This is a page surface, not a theme: colour and type come from the active
+ * LuCI theme's exported tokens. The fallbacks are only for themes that do not
+ * publish the export tier, and they keep the page readable rather than trying
+ * to reproduce Footstrap's palette.
+ *
+ * GPL-3.0. Part of luci-app-3ginfo-lite.
+ */
+
+.tg-page {
+	--tg-bg: var(--background-color-high, #fff);
+	--tg-bg-soft: var(--background-color-low, #f6f8fa);
+	--tg-text: var(--text-color-highest, #1f2328);
+	--tg-dim: var(--text-color-medium, #57606a);
+	--tg-border: var(--border-color-medium, #d0d7de);
+	--tg-accent: var(--primary-color-high, #0969da);
+	--tg-good: var(--success-color-high, #197c36);
+	--tg-warn: var(--warn-color-high, #946300);
+	--tg-bad: var(--error-color-high, #cf222e);
+	--tg-radius: var(--fs-radius-lg, 10px);
+	--tg-radius-sm: var(--fs-radius, 8px);
+	--tg-gap: 12px;
+
+	display: flex;
+	flex-direction: column;
+	gap: 0;
+	color: var(--tg-text);
+	min-width: 0;
+}
+
+.tg-page *,
+.tg-page *::before,
+.tg-page *::after {
+	box-sizing: border-box;
+}
+
+.tg-page-head {
+	display: flex;
+	flex-direction: column;
+	gap: 12px;
+	margin-bottom: 14px;
+}
+
+.tg-page-title {
+	margin: 0;
+	color: var(--tg-text);
+	font-size: 1.35rem;
+	line-height: 1.2;
+	letter-spacing: -.02em;
+}
+
+.tg-page-sub {
+	margin: 4px 0 0;
+	color: var(--tg-dim);
+	font-size: .8125rem;
+}
+
+.tg-page-actions {
+	display: flex;
+	flex-wrap: wrap;
+	align-items: center;
+	gap: 8px;
+}
+
+.tg-refresh-label {
+	display: inline-flex;
+	align-items: center;
+	gap: 7px;
+	color: var(--tg-dim);
+	font-size: .75rem;
+}
+
+.tg-select {
+	min-height: 38px;
+	max-width: 10rem;
+}
+
+.tg-button {
+	display: inline-flex;
+	align-items: center;
+	justify-content: center;
+	gap: 4px;
+	min-height: 38px;
+	white-space: nowrap;
+}
+
+.tg-button[disabled] {
+	opacity: .65;
+}
+
+.tg-refresh-glyph {
+	display: inline-block;
+	line-height: 1;
+}
+
+.tg-busy .tg-refresh-glyph {
+	animation: tg-spin .8s linear infinite;
+}
+
+@keyframes tg-spin {
+	to { transform: rotate(360deg); }
+}
+
+.tg-banner {
+	margin-bottom: 12px;
+	padding: 10px 12px;
+	border: 1px solid var(--tg-border);
+	border-radius: var(--tg-radius-sm);
+	background: var(--tg-bg-soft);
+	color: var(--tg-text);
+	font-size: .8125rem;
+}
+
+.tg-banner[hidden] {
+	display: none;
+}
+
+.tg-banner-error {
+	border-color: var(--tg-bad);
+	color: var(--tg-bad);
+}
+
+.tg-banner-warning {
+	border-color: var(--tg-warn);
+	color: var(--tg-warn);
+}
+
+.tg-banner-info {
+	border-color: var(--tg-accent);
+	color: var(--tg-text);
+}
+
+.tg-summary {
+	position: relative;
+	margin-bottom: 12px;
+	overflow: hidden;
+}
+
+.tg-summary::before {
+	content: "";
+	position: absolute;
+	inset: 0 auto 0 0;
+	width: 3px;
+	background: var(--tg-accent);
+}
+
+.tg-summary-top {
+	display: flex;
+	flex-wrap: wrap;
+	align-items: center;
+	gap: 7px;
+	margin-bottom: 9px;
+}
+
+.tg-dot {
+	display: inline-block;
+	width: 8px;
+	height: 8px;
+	flex: 0 0 8px;
+	border-radius: 50%;
+	background: var(--tg-dim);
+}
+
+.tg-dot.tg-good { background: var(--tg-good); }
+.tg-dot.tg-warn { background: var(--tg-warn); }
+.tg-dot.tg-bad { background: var(--tg-bad); }
+.tg-dot.tg-muted { background: var(--tg-dim); }
+
+.tg-age {
+	margin-left: auto;
+	color: var(--tg-dim);
+	font-size: .6875rem;
+}
+
+.tg-summary-line {
+	margin: 0 0 10px;
+	color: var(--tg-dim);
+	font-size: .8125rem;
+}
+
+.tg-badges {
+	display: flex;
+	flex-wrap: wrap;
+	gap: 6px;
+}
+
+.tg-badge {
+	display: inline-flex;
+	align-items: center;
+	min-height: 25px;
+	padding: 2px 8px;
+	border: 1px solid var(--tg-border);
+	border-radius: 999px;
+	background: var(--tg-bg-soft);
+	color: var(--tg-dim);
+	font-size: .6875rem;
+	font-weight: 650;
+	line-height: 1.3;
+	white-space: nowrap;
+}
+
+.tg-badge-accent {
+	border-color: var(--tg-accent);
+	color: var(--tg-accent);
+}
+
+.tg-badge-good {
+	border-color: var(--tg-good);
+	color: var(--tg-good);
+}
+
+.tg-badge-warn {
+	border-color: var(--tg-warn);
+	color: var(--tg-warn);
+}
+
+.tg-badge-bad {
+	border-color: var(--tg-bad);
+	color: var(--tg-bad);
+}
+
+.tg-overview,
+.tg-lower {
+	display: grid;
+	grid-template-columns: minmax(0, 1fr);
+	gap: var(--tg-gap);
+	min-width: 0;
+	/* Cards keep their own height: a half-empty card stretched to match its
+	   neighbour reads as missing content rather than as empty space. */
+	align-items: start;
+}
+
+.tg-card {
+	/* A cbi-section, so the theme paints the box. Only what the grid needs
+	   stays here, plus the scroll offset. */
+	min-width: 0;
+	scroll-margin-top: calc(var(--fs-bar-h, 0px) + 3rem);
+}
+
+/* Inside the grids the gap spaces the cards; on its own the card keeps the
+   same rhythm instead of the theme's wider section margin. */
+.tg-overview > .tg-card,
+.tg-lower > .tg-card {
+	margin-bottom: 0;
+}
+
+.tg-page > .tg-card {
+	margin-bottom: var(--tg-gap);
+}
+
+.tg-neighbour-actions {
+	display: flex;
+	flex-wrap: wrap;
+	align-items: center;
+	gap: 8px 12px;
+}
+
+.tg-card-head {
+	display: flex;
+	flex-wrap: wrap;
+	align-items: flex-start;
+	justify-content: space-between;
+	gap: 8px 12px;
+	margin-bottom: 12px;
+}
+
+.tg-card-copy {
+	min-width: 0;
+}
+
+.tg-card-title {
+	margin: 0;
+	color: var(--tg-text);
+	font-size: 1rem;
+	line-height: 1.3;
+}
+
+.tg-card-desc {
+	margin: 3px 0 0;
+	color: var(--tg-dim);
+	font-size: .75rem;
+	line-height: 1.45;
+}
+
+.tg-signal-grid {
+	display: grid;
+	grid-template-columns: minmax(0, 1fr);
+	gap: 8px;
+}
+
+.tg-tile {
+	min-width: 0;
+	padding: 11px 12px;
+	border: 1px solid var(--tg-border);
+	border-radius: var(--tg-radius-sm);
+	background: var(--tg-bg-soft);
+}
+
+.tg-tile-head {
+	display: flex;
+	flex-wrap: wrap;
+	align-items: center;
+	justify-content: space-between;
+	gap: 5px;
+	color: var(--tg-dim);
+	font-size: .6875rem;
+	font-weight: 650;
+}
+
+.tg-tile-label {
+	min-width: 0;
+}
+
+.tg-tile-value {
+	margin-top: 5px;
+	line-height: 1.2;
+}
+
+.tg-metric-value {
+	color: var(--tg-text);
+	font-size: 1.5rem;
+	font-weight: 750;
+	letter-spacing: -.03em;
+	font-variant-numeric: tabular-nums;
+}
+
+.tg-metric-unit {
+	color: var(--tg-dim);
+	font-size: .6875rem;
+	font-weight: 500;
+	letter-spacing: 0;
+}
+
+.tg-quality {
+	display: inline-flex;
+	align-items: center;
+	gap: 4px;
+	font-size: .625rem;
+	font-weight: 700;
+	white-space: nowrap;
+}
+
+.tg-quality::before {
+	content: "";
+	width: 6px;
+	height: 6px;
+	border-radius: 50%;
+	background: currentColor;
+}
+
+.tg-q-good { color: var(--tg-good); }
+.tg-q-fair { color: var(--tg-warn); }
+.tg-q-weak { color: var(--tg-bad); }
+
+.tg-muted {
+	color: var(--tg-dim) !important;
+}
+
+.tg-carrier-stack {
+	display: grid;
+	grid-template-columns: minmax(0, 1fr);
+	gap: 8px;
+}
+
+.tg-carrier {
+	display: grid;
+	grid-template-columns: minmax(0, 1fr);
+	gap: 9px;
+	min-width: 0;
+	padding: 11px 12px;
+	border: 1px solid var(--tg-border);
+	border-radius: var(--tg-radius-sm);
+	background: var(--tg-bg-soft);
+}
+
+.tg-carrier-main {
+	display: flex;
+	align-items: flex-start;
+	gap: 9px;
+	min-width: 0;
+}
+
+.tg-carrier-index {
+	display: grid;
+	place-items: center;
+	flex: 0 0 28px;
+	height: 28px;
+	border: 1px solid var(--tg-accent);
+	border-radius: 8px;
+	color: var(--tg-accent);
+	font-size: .625rem;
+	font-weight: 800;
+	line-height: 1;
+}
+
+.tg-carrier-copy {
+	min-width: 0;
+}
+
+.tg-carrier-title {
+	margin: 0;
+	color: var(--tg-text);
+	font-size: .8125rem;
+	line-height: 1.35;
+}
+
+.tg-carrier-meta {
+	margin: 2px 0 0;
+	color: var(--tg-dim);
+	font-size: .6875rem;
+	line-height: 1.45;
+	overflow-wrap: anywhere;
+}
+
+.tg-chips {
+	display: flex;
+	flex-wrap: wrap;
+	gap: 5px;
+}
+
+.tg-chip {
+	display: inline-flex;
+	flex-wrap: wrap;
+	align-items: baseline;
+	gap: 4px;
+	max-width: 100%;
+	padding: 3px 6px;
+	border: 1px solid var(--tg-border);
+	border-radius: 6px;
+	background: var(--tg-bg);
+	color: var(--tg-dim);
+	font-size: .625rem;
+	line-height: 1.4;
+}
+
+.tg-chip-label {
+	color: var(--tg-dim);
+}
+
+.tg-chip strong {
+	color: var(--tg-text);
+	font-family: var(--fs-font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
+	font-size: .6875rem;
+	font-weight: 650;
+	white-space: nowrap;
+}
+
+.tg-chip .tg-quality {
+	font-size: .5625rem;
+}
+
+.tg-kv {
+	display: grid;
+	grid-template-columns: minmax(0, 1fr);
+	gap: 8px 12px;
+	margin: 0;
+}
+
+.tg-kv-item {
+	min-width: 0;
+}
+
+.tg-kv dt {
+	margin: 0;
+	color: var(--tg-dim);
+	font-size: .625rem;
+	line-height: 1.35;
+}
+
+.tg-kv dd {
+	margin: 2px 0 0;
+	color: var(--tg-text);
+	font-size: .75rem;
+	font-weight: 650;
+	line-height: 1.4;
+	overflow-wrap: anywhere;
+}
+
+.tg-kv-compact {
+	gap: 7px 12px;
+}
+
+.tg-inline-note {
+	margin-bottom: 10px;
+	padding: 9px 10px;
+	border: 1px solid var(--tg-border);
+	border-radius: var(--tg-radius-sm);
+	background: var(--tg-bg-soft);
+	color: var(--tg-dim);
+	font-size: .6875rem;
+	line-height: 1.45;
+}
+
+.tg-inline-note[hidden] {
+	display: none;
+}
+
+.tg-neighbour-tools {
+	display: grid;
+	grid-template-columns: minmax(0, 1fr);
+	gap: 8px;
+	margin-bottom: 10px;
+}
+
+.tg-filters {
+	display: flex;
+	flex-wrap: wrap;
+	gap: 5px;
+}
+
+.tg-filter {
+	min-height: 36px;
+	padding: 0 9px;
+	border: 1px solid var(--tg-border);
+	border-radius: 999px;
+	background: var(--tg-bg-soft);
+	color: var(--tg-dim);
+	font-size: .6875rem;
+	font-weight: 650;
+	line-height: 1;
+	cursor: pointer;
+}
+
+.tg-filter-active {
+	border-color: var(--tg-accent);
+	color: var(--tg-accent);
+}
+
+.tg-search {
+	width: 100%;
+	min-width: 0;
+	min-height: 36px;
+	font-size: .75rem;
+}
+
+.tg-neighbour-cards {
+	display: grid;
+	grid-template-columns: minmax(0, 1fr);
+	gap: 8px;
+}
+
+.tg-neighbour-card {
+	min-width: 0;
+	padding: 10px 11px;
+	border: 1px solid var(--tg-border);
+	border-radius: var(--tg-radius-sm);
+	background: var(--tg-bg-soft);
+}
+
+.tg-neighbour-head {
+	display: flex;
+	flex-wrap: wrap;
+	align-items: center;
+	justify-content: space-between;
+	gap: 6px;
+	margin-bottom: 8px;
+	color: var(--tg-text);
+	font-size: .75rem;
+}
+
+.tg-neighbour-kv {
+	display: grid;
+	grid-template-columns: repeat(2, minmax(0, 1fr));
+	gap: 7px 10px;
+	margin: 0;
+}
+
+.tg-neighbour-kv dt {
+	color: var(--tg-dim);
+	font-size: .625rem;
+}
+
+.tg-neighbour-kv dd {
+	margin: 1px 0 0;
+	color: var(--tg-text);
+	font-size: .75rem;
+	font-weight: 650;
+	font-variant-numeric: tabular-nums;
+}
+
+.tg-table-wrap {
+	display: none;
+	width: 100%;
+	overflow-x: auto;
+	/* No box of its own: the card is the container, and a second border would
+	   show a second set of corners inside it. */
+}
+
+.tg-table,
+/* LuCI adds its own classes to every <table> and the theme then draws a card
+   around it. Inside our card that is a second set of corners, so the box is
+   removed here and only the rows keep their lines. */
+.tg-page table.tg-table.fs-b {
+	width: 100%;
+	min-width: 640px;
+	border: 0;
+	border-radius: 0;
+	background: none;
+	overflow: visible;
+	border-collapse: collapse;
+	color: var(--tg-text);
+	font-size: .75rem;
+	text-align: left;
+}
+
+.tg-table th,
+.tg-table td {
+	padding: 8px 9px;
+	border-bottom: 1px solid var(--tg-border);
+	white-space: nowrap;
+}
+
+.tg-table th {
+	background: var(--tg-bg-soft);
+	color: var(--tg-dim);
+	font-size: .625rem;
+	font-weight: 700;
+}
+
+.tg-table tbody tr:last-child td {
+	border-bottom: 0;
+}
+
+.tg-table tbody tr:hover {
+	background: var(--tg-bg-soft);
+}
+
+.tg-sort {
+	display: inline-flex;
+	align-items: center;
+	min-height: 24px;
+	padding: 0;
+	border: 0;
+	background: none;
+	color: inherit;
+	font: inherit;
+	cursor: pointer;
+}
+
+.tg-sort-active {
+	color: var(--tg-accent);
+}
+
+.tg-empty {
+	padding: 16px 10px;
+	border: 1px dashed var(--tg-border);
+	border-radius: var(--tg-radius-sm);
+	color: var(--tg-dim);
+	text-align: center;
+	font-size: .75rem;
+	line-height: 1.5;
+}
+
+.tg-empty strong {
+	display: block;
+	margin-bottom: 3px;
+	color: var(--tg-text);
+	font-size: .8125rem;
+}
+
+.tg-empty span {
+	display: block;
+}
+
+.tg-warnings {
+	margin-top: 12px;
+}
+
+.tg-warning-list {
+	margin: 0;
+	padding-left: 1.1rem;
+	color: var(--tg-warn);
+	font-size: .6875rem;
+	line-height: 1.5;
+}
+
+.tg-warning-list li {
+	margin-bottom: 3px;
+}
+
+.tg-details summary {
+	display: flex;
+	align-items: center;
+	min-height: 34px;
+	color: var(--tg-accent);
+	font-size: .75rem;
+	font-weight: 650;
+	cursor: pointer;
+}
+
+.tg-details[open] summary {
+	margin-bottom: 8px;
+}
+
+.tg-foot {
+	margin: 10px 0 0;
+	color: var(--tg-dim);
+	font-size: .625rem;
+	line-height: 1.5;
+}
+
+.tg-page a:focus-visible,
+.tg-page button:focus-visible,
+.tg-page summary:focus-visible,
+.tg-page input:focus-visible,
+.tg-page select:focus-visible {
+	outline: 2px solid var(--tg-accent);
+	outline-offset: 2px;
+}
+
+@media (min-width: 420px) {
+	.tg-kv {
+		grid-template-columns: repeat(2, minmax(0, 1fr));
+	}
+}
+
+@media (min-width: 520px) {
+	.tg-page-head {
+		flex-direction: row;
+		align-items: flex-end;
+		justify-content: space-between;
+	}
+
+	.tg-page-actions {
+		justify-content: flex-end;
+	}
+
+	.tg-signal-grid {
+		grid-template-columns: repeat(2, minmax(0, 1fr));
+	}
+
+	.tg-carrier {
+		grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
+		align-items: center;
+	}
+
+	.tg-neighbour-tools {
+		grid-template-columns: auto minmax(12rem, 1fr);
+		align-items: center;
+	}
+
+	.tg-neighbour-cards {
+		grid-template-columns: repeat(2, minmax(0, 1fr));
+	}
+}
+
+@media (min-width: 768px) {
+	.tg-signal-grid {
+		grid-template-columns: repeat(4, minmax(0, 1fr));
+	}
+
+	.tg-kv {
+		grid-template-columns: repeat(3, minmax(0, 1fr));
+	}
+
+	/* The network card sits in the narrow column; two wide fields read better
+	   there than three cramped ones, and a long firmware id stays on one line. */
+	#tg-network-grid {
+		grid-template-columns: repeat(2, minmax(0, 1fr));
+	}
+
+	.tg-neighbour-cards {
+		display: none;
+	}
+
+	.tg-table-wrap {
+		display: block;
+	}
+
+	.tg-lower {
+		grid-template-columns: repeat(2, minmax(0, 1fr));
+	}
+}
+
+@media (min-width: 1000px) {
+	.tg-overview {
+		grid-template-columns: minmax(0, 1.45fr) minmax(18rem, .8fr);
+		align-items: start;
+	}
+
+	.tg-overview #tg-signal {
+		grid-column: 1;
+	}
+
+	.tg-overview #tg-serving {
+		grid-column: 1;
+	}
+
+	.tg-overview #tg-network {
+		grid-column: 2;
+		grid-row: 1 / span 2;
+	}
+}
+
+@media (max-width: 380px) {
+	.tg-card,
+	.tg-summary {
+		padding: 12px;
+	}
+
+	.tg-page-title {
+		font-size: 1.2rem;
+	}
+
+	.tg-age {
+		width: 100%;
+		margin-left: 0;
+	}
+
+	.tg-neighbour-kv {
+		grid-template-columns: minmax(0, 1fr);
+	}
+}
+
+@media (prefers-reduced-motion: reduce) {
+	.tg-busy .tg-refresh-glyph {
+		animation-duration: .01ms;
+	}
+}
diff --git a/luci-app-3ginfo-lite/htdocs/luci-static/resources/view/modem/3gconfig.js b/luci-app-3ginfo-lite/htdocs/luci-static/resources/view/modem/3gconfig.js
