+#!/bin/sh
+# Offline checks for the radio normalizer and AT+QCAINFO parser.
+#
+# Run from the package directory: sh tests/run.sh
+# GPL-3.0. Part of luci-app-3ginfo-lite.
+
+set -eu
+
+ROOT=$(cd "$(dirname "$0")/.." && pwd)
+RES="$ROOT/root/usr/share/3ginfo-lite"
+FIX="$ROOT/tests/fixtures"
+TMP=$(mktemp -d /tmp/3ginfo-tests.XXXXXX)
+trap 'rm -rf "$TMP"' EXIT INT TERM
+
+fail() {
+	echo "FAIL: $1" >&2
+	exit 1
+}
+
+check() {
+	[ "$2" = "$3" ] || fail "$1 (expected '$3', got '$2')"
+}
+
+qca_parse() {
+	awk -f "$RES/radio-qca.awk" "$1"
+}
+
+normalize() {
+	source=$1
+	cell=$2
+	band=$3
+	qca=$4
+	legacy=$5
+	sim=${6:-"$FIX/qmodem/sim.json"}
+	iface=${7:-"$FIX/qmodem/iface.json"}
+	awk -f "$RES/radio-qca.awk" "$qca" > "$TMP/qca.tsv"
+	jq -n --arg source "$source" --argjson generated 1760000000 \
+		--argjson qca_ok "$([ -s "$TMP/qca.tsv" ] && echo true || echo false)" \
+		--argjson has_neighbors true --arg warnings '' \
+		--argjson sample_ttl 25 --argjson neighbor_min 60 --argjson neighbor_ttl 120 \
+		--arg section 4_1 \
+		--slurpfile base "$FIX/qmodem/base.json" \
+		--slurpfile cell "$cell" --slurpfile band "$band" \
+		--slurpfile sim "$sim" --slurpfile legacy "$legacy" \
+		--slurpfile iface "$iface" --rawfile qca "$TMP/qca.tsv" \
+		-f "$RES/radio-normalize.jq"
+}
+
+# --- parser ----------------------------------------------------------------
+qca_parse "$FIX/qmodem/qca.txt" > "$TMP/qca-endc"
+check "QCA LTE PCC RSRP" "$(awk -F '\t' 'NR==1 {print $3}' "$TMP/qca-endc")" "-91"
+check "QCA LTE SCC RSRQ" "$(awk -F '\t' 'NR==2 {print $4}' "$TMP/qca-endc")" "-13"
+check "QCA NR SCS is not SINR" "$(awk -F '\t' 'NR==3 {print $6}' "$TMP/qca-endc")" "-"
+
+qca_parse "$FIX/qca/missing.txt" > "$TMP/qca-missing"
+check "QCA keeps a missing RSRP empty" "$(awk -F '\t' 'NR==1 {print $3}' "$TMP/qca-missing")" "-"
+check "QCA ignores malformed channels" "$(wc -l < "$TMP/qca-missing" | tr -d ' ')" "2"
+
+qca_parse "$FIX/qca/nr_variants.txt" > "$TMP/qca-nr"
+check "QCA NR with SCS 0 keeps metrics empty" "$(awk -F '\t' 'NR==1 {print $3}' "$TMP/qca-nr")" "-"
+check "QCA NR without SCS reads RSRP" "$(awk -F '\t' 'NR==2 {print $3}' "$TMP/qca-nr")" "-89"
+
+# --- EN-DC ----------------------------------------------------------------
+normalize qmodem "$FIX/qmodem/cell_endc.json" "$FIX/qmodem/band_endc.json" \
+	"$FIX/qmodem/qca.txt" "$FIX/empty.json" > "$TMP/endc.json"
+check "EN-DC mode" "$(jq -r '.connection.mode' "$TMP/endc.json")" "5G NSA"
+check "EN-DC carrier count" "$(jq -r '.connection.carrier_count' "$TMP/endc.json")" "3"
+check "EN-DC CA flag" "$(jq -r '.connection.ca_active' "$TMP/endc.json")" "true"
+check "EN-DC LTE PCC band" "$(jq -r '.cells[] | select(.role=="pcc") | .band' "$TMP/endc.json")" "3"
+check "EN-DC NR leg band" "$(jq -r '.cells[] | select(.role=="nsa") | .band' "$TMP/endc.json")" "78"
+check "EN-DC LTE SCC RSRP" "$(jq -r '.cells[] | select(.role=="scc") | .metrics.rsrp' "$TMP/endc.json")" "-103"
+check "EN-DC per-carrier metrics capability" "$(jq -r '.capabilities.per_carrier_metrics' "$TMP/endc.json")" "true"
+check "EN-DC neighbour capability" "$(jq -r '.capabilities.neighbors' "$TMP/endc.json")" "true"
+
+# Some Quectel firmware labels the NR leg PCC in QCAINFO. In EN-DC it is still
+# the NSA leg, never a standalone serving cell.
+normalize qmodem "$FIX/qmodem/cell_endc.json" "$FIX/qmodem/band_endc.json" \
+	"$FIX/qca/nsa_nr_pcc.txt" "$FIX/empty.json" > "$TMP/endc-nr-pcc.json"
+check "NR leg stays NSA when QCAINFO calls it PCC" "$(jq -r '.cells[] | select(.rat=="nr") | .role' "$TMP/endc-nr-pcc.json")" "nsa"
+
+# --- SA -------------------------------------------------------------------
+normalize qmodem "$FIX/qmodem/cell_sa.json" "$FIX/qmodem/band_sa.json" \
+	"$FIX/qmodem/qca_sa.txt" "$FIX/empty.json" > "$TMP/sa.json"
+check "SA mode" "$(jq -r '.connection.mode' "$TMP/sa.json")" "5G SA"
+check "SA carrier count" "$(jq -r '.connection.carrier_count' "$TMP/sa.json")" "2"
+check "SA PCC RAT" "$(jq -r '.cells[] | select(.role=="pcc") | .rat' "$TMP/sa.json")" "nr"
+check "SA SCC RSRP" "$(jq -r '.cells[] | select(.role=="scc") | .metrics.rsrp' "$TMP/sa.json")" "-95"
+check "SA SCC has no invented SINR" "$(jq -r '.cells[] | select(.role=="scc") | .metrics.sinr // "missing"' "$TMP/sa.json")" "missing"
+
+# --- LTE ------------------------------------------------------------------
+normalize qmodem "$FIX/qmodem/cell_lte.json" "$FIX/qmodem/band_lte.json" \
+	"$FIX/qmodem/qca_lte.txt" "$FIX/empty.json" > "$TMP/lte.json"
+check "LTE-A mode" "$(jq -r '.connection.mode' "$TMP/lte.json")" "LTE-A"
+check "LTE-A SCC present" "$(jq -r '[.cells[] | select(.role=="scc")] | length' "$TMP/lte.json")" "1"
+
+# --- 3G -------------------------------------------------------------------
+normalize qmodem "$FIX/qmodem/cell_3g.json" "$FIX/empty.json" \
+	"$FIX/empty.txt" "$FIX/empty.json" > "$TMP/3g.json"
+check "3G mode" "$(jq -r '.connection.mode' "$TMP/3g.json")" "3G"
+check "3G RSCP" "$(jq -r '.cells[0].metrics.rscp' "$TMP/3g.json")" "-82"
+
+# --- legacy fallback ------------------------------------------------------
+normalize legacy "$FIX/empty.json" "$FIX/empty.json" "$FIX/empty.txt" \
+	"$FIX/legacy/lte_ca.json" > "$TMP/legacy-lte.json"
+check "legacy source" "$(jq -r '.meta.source' "$TMP/legacy-lte.json")" "legacy"
+check "legacy LTE-A mode" "$(jq -r '.connection.mode' "$TMP/legacy-lte.json")" "LTE-A"
+check "legacy SCC identity only" "$(jq -r '[.cells[] | select(.role=="scc")][0].metrics | length' "$TMP/legacy-lte.json")" "0"
+
+normalize legacy "$FIX/empty.json" "$FIX/empty.json" "$FIX/empty.txt" \
+	"$FIX/legacy/nsa.json" > "$TMP/legacy-nsa.json"
+check "legacy NSA anchor is LTE" "$(jq -r '.cells[] | select(.role=="pcc") | .rat' "$TMP/legacy-nsa.json")" "lte"
+check "legacy NSA leg is NR" "$(jq -r '.cells[] | select(.role=="nsa") | .rat' "$TMP/legacy-nsa.json")" "nr"
+
+# --- missing everything ---------------------------------------------------
+normalize legacy "$FIX/empty.json" "$FIX/empty.json" "$FIX/empty.txt" \
+	"$FIX/empty.json" > "$TMP/empty.json"
+check "empty snapshot is unavailable" "$(jq -r '.connection.status' "$TMP/empty.json")" "unavailable"
+check "empty snapshot has no cells" "$(jq -r '.cells | length' "$TMP/empty.json")" "0"
+
+# --- neighbours -----------------------------------------------------------
+jq -n --argjson available true --arg error '' --argjson now 1760000000 \
+	--slurpfile raw "$FIX/qmodem/neighbors.json" \
+	-f "$RES/radio-neighbors.jq" > "$TMP/neighbours.json"
+check "neighbour LTE count" "$(jq -r '.lte | length' "$TMP/neighbours.json")" "2"
+check "neighbour NR count" "$(jq -r '.nr | length' "$TMP/neighbours.json")" "1"
+check "neighbour strongest first" "$(jq -r '.lte[0].pci' "$TMP/neighbours.json")" "321"
+check "neighbour missing RSRQ stays null" "$(jq -r '.lte[1].rsrq // "missing"' "$TMP/neighbours.json")" "missing"
+
+jq -n --argjson available true --arg error '' --argjson now 1760000000 \
+	--slurpfile raw "$FIX/qmodem/neighbors_missing_rsrp.json" \
+	-f "$RES/radio-neighbors.jq" > "$TMP/neighbours-missing.json"
+check "neighbour with no RSRP sorts last" "$(jq -r '.lte[1].pci' "$TMP/neighbours-missing.json")" "110"
+
+# --- neighbours: implausible firmware values ------------------------------
+# Some QModem firmware revisions shift the AT+QENG neighbour columns, so a row
+# can carry RSRP -9 / RSRQ -92. Out-of-range values are misparsed fields, not a
+# strong signal: they must be dropped while the sane row survives.
+jq -n --argjson available true --arg error '' --argjson now 1760000000 \
+	--slurpfile raw "$FIX/qmodem/neighbors_out_of_range.json" \
+	-f "$RES/radio-neighbors.jq" > "$TMP/neighbours-range.json"
+check "swapped RSRP/RSRQ pair is repaired" \
+	"$(jq -r '.lte[] | select(.pci==227) | "\(.rsrp)/\(.rsrq)"' "$TMP/neighbours-range.json")" "-92/-9"
+check "valid pair is left untouched" \
+	"$(jq -r '.lte[] | select(.pci==321) | "\(.rsrp)/\(.rsrq)"' "$TMP/neighbours-range.json")" "-98/-12"
+check "impossible pair is dropped" \
+	"$(jq -r '.lte[] | select(.pci==400) | "\(.rsrp // "missing")/\(.rsrq // "missing")"' "$TMP/neighbours-range.json")" "missing/missing"
+check "strongest neighbour ranks first" \
+	"$(jq -r '.lte[0].pci' "$TMP/neighbours-range.json")" "227"
+
+# --- legacy band parsing --------------------------------------------------
+# "B7 (2600 MHz) @20 MHz" and "5G NSA | n78 (3500 MHz)" are the shapes 3ginfo.sh
+# emits; the band number must come out without a regex engine.
+check "legacy NSA leg band" "$(jq -r '.cells[] | select(.role=="nsa") | .band' "$TMP/legacy-nsa.json")" "78"
+
+# --- jq portability -------------------------------------------------------
+# OpenWrt builds jq without Oniguruma: test/match/scan/gsub/sub/splits/capture
+# fail at run time there. A regex creeping back in breaks the page on the
+# router while passing on a laptop, so guard it here.
+if sed 's/#.*$//' "$RES/radio-normalize.jq" "$RES/radio-neighbors.jq" |
+	grep -nE '\b(test|match|scan|gsub|sub|splits|capture)[[:space:]]*\('; then
+	fail "a jq program uses a regex builtin that OpenWrt's jq does not provide"
+fi
+
+# --- shell syntax ---------------------------------------------------------
+sh -n "$RES/radiodata.sh" || fail "radiodata.sh has a shell syntax error"
+
+echo "PASS: radio normalizer and QCA parser"
