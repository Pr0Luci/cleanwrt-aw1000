diff --git a/luci-app-3ginfo-lite/root/usr/share/3ginfo-lite/radio-neighbors.jq b/luci-app-3ginfo-lite/root/usr/share/3ginfo-lite/radio-neighbors.jq
new file mode 100644
index 0000000..ece7e02
--- /dev/null
+++ b/luci-app-3ginfo-lite/root/usr/share/3ginfo-lite/radio-neighbors.jq
@@ -0,0 +1,95 @@
+# Normalize QModem's get_neighborcell reply.
+#
+# QModem has already done the vendor-specific AT parsing. It exposes LTE and NR
+# arrays with arfcn, pci, rsrp and rsrq. A neighbour report never carries a
+# global cell id on the Quectel firmware this app targets, so cell_id stays null
+# rather than being guessed from a PCI.
+#
+# OpenWrt builds jq without the Oniguruma regex engine, so this file uses no
+# regex builtins. Values are range-checked before they reach the page: some
+# firmware revisions shift AT+QENG neighbour columns, and a value outside the
+# 3GPP range is dropped rather than shown as an excellent signal.
+#
+# GPL-3.0. Part of luci-app-3ginfo-lite.
+
+def space_char: . == 32 or . == 9 or . == 10 or . == 13 or . == 11 or . == 12 or . == 160;
+
+def trim:
+  explode
+  | [ to_entries[] | select(.value | space_char | not) ] as $keep
+  | if ($keep | length) == 0 then ""
+    else ($keep[0].key) as $s
+    | ($keep[-1].key) as $e
+    | .[$s:$e + 1]
+    | implode
+    end;
+
+def dash_normalize:
+  explode
+  | map(if . == 8722 or . == 8211 or . == 8212 then 45 else . end)
+  | implode;
+
+def text:
+  if . == null then null
+  else (tostring | trim | dash_normalize) as $s
+  | if ($s == "" or $s == "-" or $s == "N/A" or $s == "n/a") then null
+    else $s end
+  end;
+
+def number:
+  if . == null then null
+  else (tostring | trim | dash_normalize) as $s
+  | if ($s == "" or $s == "-" or $s == "N/A" or $s == "n/a") then null
+    else (tonumber? // null) end
+  end;
+
+# RSRP/RSRQ/SINR/RSCP/Ec-N0 ranges from 3GPP TS 36.133/38.133. A value outside
+# them is not a weak signal, it is a misparsed field, so it becomes "not
+# reported" instead of colouring the row.
+def within($lo; $hi):
+  if . == null then null elif . >= $lo and . <= $hi then . else null end;
+
+# QModem 25.x reads AT+QENG's LTE neighbour row as rsrp=<RSRQ>, rsrq=<RSRP>,
+# while the AT command reports <RSRQ> then <RSRP> (QModem vendor/quectel.sh).
+# The two fields are therefore swapped on LTE rows for some firmware. Repair
+# the row only when exactly one assignment is physically possible; a pair that
+# is valid as written is never touched, and a pair valid as neither is dropped.
+def repair_lte_pair($rsrp; $rsrq):
+  if ($rsrp | within(-156; -30)) != null and ($rsrq | within(-30; 3)) != null then
+    { rsrp: $rsrp, rsrq: $rsrq }
+  elif ($rsrp | within(-30; 3)) != null and ($rsrq | within(-156; -30)) != null then
+    { rsrp: ($rsrq | within(-156; -30)), rsrq: ($rsrp | within(-30; 3)) }
+  else
+    { rsrp: ($rsrp | within(-156; -30)), rsrq: ($rsrq | within(-30; 3)) }
+  end;
+
+def rows($rat):
+  [ $raw[0].neighborcell[$rat][]?
+    | (.rsrp | number) as $rsrp
+    | (.rsrq | number) as $rsrq
+    | (if $rat == "LTE" then repair_lte_pair($rsrp; $rsrq)
+       else { rsrp: ($rsrp | within(-156; -30)), rsrq: ($rsrq | within(-43; 20)) }
+       end) as $m
+    | { rat: ($rat | ascii_downcase),
+        type: (.neighbourcell | text),
+        channel: (.arfcn | number),
+        pci: (.pci | number),
+        rsrp: $m.rsrp,
+        rsrq: $m.rsrq,
+        sinr: (.sinr | number | within(-30; 50)),
+        rscp: (.rscp | number | within(-130; -20)),
+        ecno: (.ecno | number | within(-30; 5)),
+        cell_id: (.cell_id | text) }
+    | select(.channel != null and .pci != null) ]
+  | unique_by([.channel, .pci])
+  | sort_by([if .rsrp == null then 1 else 0 end, ((.rsrp // 0) * -1)])
+  | .[0:40];
+
+{
+  lte: rows("LTE"),
+  nr: rows("NR"),
+  scanned: $now,
+  available: $available,
+  error: (if $error == "" then null else $error end),
+  cached: false
+}
diff --git a/luci-app-3ginfo-lite/root/usr/share/3ginfo-lite/radio-normalize.jq b/luci-app-3ginfo-lite/root/usr/share/3ginfo-lite/radio-normalize.jq
new file mode 100644
index 0000000..c11d720
--- /dev/null
+++ b/luci-app-3ginfo-lite/root/usr/share/3ginfo-lite/radio-normalize.jq
@@ -0,0 +1,467 @@
+# Normalize 3gInfo-lite's telemetry sources into one stable document.
+#
+# Inputs are files produced by radiodata.sh. QModem is authoritative when it is
+# present: its ubus methods already serialize access to the modem's AT port.
+# Without QModem the collector falls back to 3ginfo.sh, which is why every field
+# below is allowed to be absent.
+#
+# OpenWrt builds jq without the Oniguruma regex engine, so this file uses no
+# regex builtins (test/match/scan/gsub/sub/splits). All string work is done on
+# codepoints, which keeps the normalizer identical on the router and on a laptop.
+#
+# GPL-3.0. Part of luci-app-3ginfo-lite.
+
+# Space characters as Unicode sees them; trims NBSP too, which some modems send.
+def space_char: . == 32 or . == 9 or . == 10 or . == 13 or . == 11 or . == 12 or . == 160;
+
+def trim:
+  explode
+  | [ to_entries[] | select(.value | space_char | not) ] as $keep
+  | if ($keep | length) == 0 then ""
+    else ($keep[0].key) as $s
+    | ($keep[-1].key) as $e
+    | .[$s:$e + 1]
+    | implode
+    end;
+
+# Modems mix U+2212 MINUS SIGN (and the en/em dashes) with ASCII '-' in
+# measurement fields; fold them to ASCII before any number is parsed.
+def dash_normalize:
+  explode
+  | map(if . == 8722 or . == 8211 or . == 8212 then 45 else . end)
+  | implode;
+
+# Every run of ASCII digits in a string, in order. Replaces scan("[0-9]+").
+def digit_groups:
+  explode
+  | reduce .[] as $c ({ cur: [], out: [] };
+      if ($c >= 48 and $c <= 57) then .cur += [ $c ]
+      else (if (.cur | length) > 0 then .out += [ (.cur | implode) ] | .cur = [] else . end)
+      end)
+  | if (.cur | length) > 0 then .out + [ (.cur | implode) ] else .out end;
+
+def first_digits: digit_groups | (.[0] // null);
+
+# Alphanumeric words, in order.
+def word_tokens:
+  explode
+  | reduce .[] as $c ({ cur: [], out: [] };
+      if (($c >= 48 and $c <= 57) or ($c >= 65 and $c <= 90) or ($c >= 97 and $c <= 122))
+      then .cur += [ $c ]
+      else (if (.cur | length) > 0 then .out += [ (.cur | implode) ] | .cur = [] else . end)
+      end)
+  | if (.cur | length) > 0 then .out + [ (.cur | implode) ] else .out end;
+
+def text:
+  if . == null then null
+  else (tostring | trim | dash_normalize) as $s
+  | if ($s == "" or $s == "-" or $s == "N/A" or $s == "n/a") then null
+    else $s end
+  end;
+
+def number:
+  if . == null then null
+  else (tostring | trim | dash_normalize) as $s
+  | if ($s == "" or $s == "-" or $s == "N/A" or $s == "n/a") then null
+    else (tonumber? // null) end
+  end;
+
+def first_number:
+  if . == null then null
+  else (tostring | dash_normalize | split("/")[0]
+        | explode
+        | map(select((. >= 48 and . <= 57) or . == 43 or . == 45 or . == 46))
+        | implode) as $s
+  | if ($s == "" or $s == "-" or $s == ".") then null else (tonumber? // null) end
+  end;
+
+# Cell Information's Band is a bare number. Legacy handlers produce "B3", "n78"
+# or "B7 @20 MHz", so take the first run of digits for those.
+def band_number:
+  text as $s
+  | if $s == null then null
+    else ($s | first_digits) as $n
+    | if $n == null then null else ($n | tonumber) end
+    end;
+
+# AT+QCAINFO names the band in a sentence ("LTE BAND 3", "NR5G BAND 78").
+def qca_band:
+  text as $s
+  | if $s == null then null
+    else ($s | ascii_upcase) as $u
+    | (($u | index("BAND")) as $p
+       | if $p != null then ($u | .[$p + 4:] | first_digits)
+         elif ($u | length) > 0 and (($u[0:1]) == "B" or ($u[0:1]) == "N")
+         then ($u | .[1:] | first_digits)
+         else null end) as $n
+    | if $n == null then null else ($n | tonumber) end
+    end;
+
+def present($m): $m | with_entries(select(.value != null));
+
+def info_entries($group):
+  [ .modem_info[]?
+    | select(if $group == "root"
+             then ((.extra_info // "") == "")
+             else ((.extra_info // "") == $group) end)
+    | { key: (.key | tostring), value } ]
+  | reduce .[] as $x ({}; .[$x.key] = $x.value);
+
+def base_entries:
+  [ .modem_info[]? | { key: (.key | tostring), value } ]
+  | reduce .[] as $x ({}; .[$x.key] = $x.value);
+
+def role_rank: if . == "pcc" then 0 elif . == "nsa" then 1 else 2 end;
+
+# Cell Information groups its fields by RAT in extra_info. Some firmware also
+# leaves the serving RSSI/CQI at the root, so every read falls back to the root
+# group ($f) before it becomes "not reported".
+def pick_group($a; $b):
+  if ($a | length) > 0 and
+     (($a.Band // $a.EARFCN // $a.ARFCN // $a.UARFCN // $a."Physical Cell ID" // $a.PSC) != null)
+  then $a else $b end;
+
+def lte_cell($i; $f; $role):
+  if ($i | length) == 0 then empty else
+    { role: $role,
+      rat: "lte",
+      band: (($i.Band // $f.Band) | band_number),
+      channel: (($i.EARFCN // $f.EARFCN) | number),
+      channel_label: "EARFCN",
+      pci: (($i."Physical Cell ID" // $f."Physical Cell ID") | first_number),
+      cell_id: (($i."Cell ID" // $f."Cell ID") | text),
+      tac: (($i.TAC // $f.TAC) | text),
+      bandwidth: { dl: (($i."DL Bandwidth" // $f."DL Bandwidth") | number),
+                   ul: (($i."UL Bandwidth" // $f."UL Bandwidth") | number) },
+      metrics: present({ rsrp: (($i.RSRP // $f.RSRP) | number),
+                         rsrq: (($i.RSRQ // $f.RSRQ) | number),
+                         rssi: (($i.RSSI // $f.RSSI) | number),
+                         sinr: (($i.SINR // $f.SINR) | number) }),
+      metric_source: "cell" }
+  end;
+
+def nr_cell($i; $f; $role):
+  if ($i | length) == 0 then empty else
+    { role: $role,
+      rat: "nr",
+      band: (($i.Band // $f.Band) | band_number),
+      channel: (($i.ARFCN // $f.ARFCN) | number),
+      channel_label: "NR-ARFCN",
+      pci: (($i."Physical Cell ID" // $f."Physical Cell ID") | first_number),
+      cell_id: (($i."Cell ID" // $f."Cell ID") | text),
+      tac: (($i.TAC // $f.TAC) | text),
+      bandwidth: { dl: (($i."DL Bandwidth" // $f."DL Bandwidth") | number), ul: null },
+      scs: (($i.SCS // $f.SCS) | number),
+      metrics: present({ rsrp: (($i.RSRP // $f.RSRP) | number),
+                         rsrq: (($i.RSRQ // $f.RSRQ) | number),
+                         sinr: (($i.SINR // $f.SINR) | number) }),
+      metric_source: "cell" }
+  end;
+
+def wcdma_cell($i; $f):
+  if ($i | length) == 0 then empty else
+    { role: "pcc",
+      rat: "3g",
+      band: (($i.Band // $f.Band) | band_number),
+      channel: (($i.UARFCN // $f.UARFCN) | number),
+      channel_label: "UARFCN",
+      pci: (($i.PSC // $f.PSC) | first_number),
+      cell_id: (($i."Cell ID" // $f."Cell ID") | text),
+      lac: (($i.LAC // $f.LAC) | text),
+      metrics: present({ rscp: (($i.RSCP // $f.RSCP) | number),
+                         ecio: (($i."Ec/Io" // $f."Ec/Io") | number) }),
+      metric_source: "cell" }
+  end;
+
+# One row for each QCAINFO line the awk parser accepted.
+def qca_rows:
+  [ $qca | split("\n")[]
+    | select((trim) != "")
+    | split("\t")
+    | { channel: (.[0] | number),
+        pci: (.[1] | number),
+        rsrp: (.[2] | number),
+        rsrq: (.[3] | number),
+        rssi: (.[4] | number),
+        sinr: (.[5] | number),
+        rat: (.[6] | text),
+        band: (.[7] | text),
+        type: (.[8] | text) }
+    | select(.channel != null) ];
+
+def qca_match($rat; $channel; $pci):
+  [ qca_rows[] | select(.rat == $rat and .channel == $channel) ] as $same
+  | (($same | map(select($pci != null and .pci == $pci)) | first) // ($same | first));
+
+def attach_metrics($cell):
+  qca_match($cell.rat; $cell.channel; $cell.pci) as $q
+  | if $q == null then $cell
+    else $cell + {
+      metrics: (present({ rsrp: ($q.rsrp), rsrq: ($q.rsrq),
+                          rssi: ($q.rssi), sinr: ($q.sinr) })
+                + ($cell.metrics // {})),
+      metric_source: (if (($cell.metrics // {}) | length) > 0
+                      then $cell.metric_source else "qca" end)
+    }
+    end;
+
+# Combine cells that describe the same carrier. A primary role wins over a
+# secondary one, and a measurement from Cell Information wins over QCAINFO.
+def merge_cells($a; $b):
+  (($a + $b)
+   | group_by("\(.rat):\(.channel // "-"):\(.pci // "-")"))
+  | map(. as $g
+    | (($g | map(select(.role == "pcc")))
+       + ($g | map(select(.role == "nsa")))
+       + $g) as $ordered
+    | ($ordered[0]) as $first
+    | $first + {
+        role: ($g | map(.role) | map(select(. != null)) | sort_by(role_rank) | .[0]),
+        band: ($g | map(.band) | map(select(. != null)) | first),
+        channel: ($g | map(.channel) | map(select(. != null)) | first),
+        pci: ($g | map(.pci) | map(select(. != null)) | first),
+        cell_id: ($g | map(.cell_id) | map(select(. != null)) | first),
+        tac: ($g | map(.tac) | map(select(. != null)) | first),
+        lac: ($g | map(.lac) | map(select(. != null)) | first),
+        scs: ($g | map(.scs) | map(select(. != null)) | first),
+        bandwidth: {
+          dl: ($g | map(.bandwidth.dl?) | map(select(. != null)) | first),
+          ul: ($g | map(.bandwidth.ul?) | map(select(. != null)) | first)
+        },
+        metrics: (reduce ($g | sort_by(
+                    if .metric_source == "qca" then 0
+                    elif .metric_source == "current_band" then 1
+                    elif .metric_source == "cell" then 3
+                    else 2 end)[]) as $c ({}; . + ($c.metrics // {}))),
+        metric_source: (if any($g[]; .metric_source == "cell") then "cell"
+                        elif any($g[]; .metric_source == "qca") then "qca"
+                        else ($g[0].metric_source) end)
+      })
+  | sort_by((.role | role_rank), .rat, (.channel // 0));
+
+($base[0] // {}) as $base0
+| ($cell[0] // {}) as $cell0
+| ($band[0] // {}) as $band0
+| ($sim[0] // {}) as $sim0
+| ($legacy[0] // {}) as $legacy0
+| ($iface[0] // {}) as $iface0
+| ($base0 | base_entries) as $basei
+| ($sim0 | base_entries) as $simi
+| ($cell0 | info_entries("root")) as $root
+| ($cell0 | info_entries("LTE")) as $lte
+| ($cell0 | info_entries("NR")) as $nr
+| ($root.network_mode // "") as $qmode
+| ($legacy0.mode // "") as $lmode
+| ($qmode | ascii_upcase) as $qu
+| ($lmode | ascii_upcase) as $lu
+| ($qu | contains("EN-DC")) as $is_endc
+| ($qu | contains("NR5G-SA")) as $is_sa
+| ($qu | contains("LTE") or contains("CAT-M") or contains("CAT-NB")) as $is_lte
+| ($qu | contains("WCDMA")) as $is_3g
+| ($lu | contains("NSA")) as $legacy_endc
+| ($lu | contains("5G SA") or contains("NR5G-SA")) as $legacy_sa
+| ($lu | contains("LTE")) as $legacy_lte
+| ($lu | contains("UMTS") or contains("HSPA") or contains("WCDMA") or contains("3G")) as $legacy_3g
+
+| (if $source == "qmodem" then
+     (if $is_endc then
+        ([ lte_cell(pick_group($lte; $root); $root; "pcc") ]
+         + [ nr_cell(pick_group($nr; $root); $root; "nsa") ])
+      elif $is_sa then [ nr_cell(pick_group($nr; $root); $root; "pcc") ]
+      elif $is_lte then [ lte_cell(pick_group($lte; $root); $root; "pcc") ]
+      elif $is_3g then [ wcdma_cell(pick_group($lte; $root); $root) ]
+      else [] end)
+   else
+       (if ($legacy0 | length) == 0 then []
+        elif $legacy_endc or $legacy_sa then
+          [ { role: "pcc",
+              rat: (if $legacy_sa then "nr" else "lte" end),
+              band: ($legacy0.pband | band_number),
+              channel: ($legacy0.earfcn | number),
+              channel_label: (if $legacy_sa then "NR-ARFCN" else "EARFCN" end),
+              pci: ($legacy0.pci | first_number),
+              cell_id: ($legacy0.cid_dec | text),
+              tac: (($legacy0.tac_d // $legacy0.tac_dec) | text),
+              metrics: present({ rsrp: ($legacy0.rsrp | number),
+                                 rsrq: ($legacy0.rsrq | number),
+                                 rssi: ($legacy0.rssi | number),
+                                 sinr: ($legacy0.sinr | number) }),
+              metric_source: "legacy" } ]
+          + (if $legacy_endc then
+               ([ (($lu | word_tokens)[]) | select(startswith("N") and length >= 2 and length <= 4)
+                  | .[1:] | (tonumber? // null)
+                  | select(. != null and . >= 1 and . <= 1024) ] | first) as $nrb
+               | if $nrb == null then [] else
+                   [ { role: "nsa", rat: "nr", band: ($nrb | tonumber),
+                       channel: null, channel_label: "NR-ARFCN", pci: null,
+                       metrics: {}, metric_source: "legacy" } ]
+                 end
+             else [] end)
+        elif $legacy_lte or $legacy_3g then
+          [ { role: "pcc",
+              rat: (if $legacy_3g then "3g" else "lte" end),
+              band: ($legacy0.pband | band_number),
+              channel: ($legacy0.earfcn | number),
+              channel_label: (if $legacy_3g then "UARFCN" else "EARFCN" end),
+              pci: ($legacy0.pci | first_number),
+              cell_id: ($legacy0.cid_dec | text),
+              tac: (($legacy0.tac_d // $legacy0.tac_dec) | text),
+              lac: ($legacy0.lac_dec | text),
+              metrics: present({ rsrp: ($legacy0.rsrp | number),
+                                 rsrq: ($legacy0.rsrq | number),
+                                 rssi: ($legacy0.rssi | number),
+                                 sinr: ($legacy0.sinr | number) }),
+              metric_source: "legacy" } ]
+      else [] end)
+   end) as $primary
+| [ $band0.current_band.cells[]?
+    | . as $c
+    | { role: (($c.role | text) // "scc"),
+        rat: (if ((($c.rat | text) // "") | ascii_upcase | contains("NR")) then "nr" else "lte" end),
+        band: ($c.band | band_number),
+        channel: ($c.channel | number),
+        channel_label: (($c.channel_type | text) //
+                        (if ((($c.rat | text) // "") | ascii_upcase | contains("NR")) then "NR-ARFCN" else "EARFCN" end)),
+        pci: ($c.pci | first_number),
+        bandwidth: { dl: ($c.dl_bandwidth | number), ul: ($c.ul_bandwidth | number) },
+        scs: ($c.scs | number),
+        metrics: {},
+        metric_source: "current_band" }
+    | select(.band != null or .channel != null or .pci != null) ] as $bandcells
+| [ qca_rows[]
+    | { role: (if (.type // "") == "pcc" then "pcc" else "scc" end),
+        rat: (.rat // "lte"),
+        band: (.band | qca_band),
+        channel: .channel,
+        channel_label: (if (.rat // "lte") == "nr" then "NR-ARFCN" else "EARFCN" end),
+        pci: .pci,
+        metrics: present({ rsrp: .rsrp, rsrq: .rsrq, rssi: .rssi, sinr: .sinr }),
+        metric_source: "qca" }
+    | select(.channel != null or .pci != null) ] as $qcacells
+| (if $source != "qmodem" then
+     [ range(1; 5) as $i
+       | ($legacy0["s\($i)band"] | text) as $b
+       | select($b != null)
+       | { role: "scc",
+           rat: (if ($b | startswith("n") or startswith("N")) then "nr" else "lte" end),
+           band: ($b | band_number),
+           channel: ($legacy0["s\($i)earfcn"] | number),
+           channel_label: (if ($b | startswith("n") or startswith("N")) then "NR-ARFCN" else "EARFCN" end),
+           pci: ($legacy0["s\($i)pci"] | first_number),
+           metrics: {},
+           metric_source: "legacy" } ]
+   else [] end) as $legacycells
+| (if $source == "qmodem" then
+     (if $is_endc then "nsa" elif $is_sa then "sa" elif $is_lte then "lte"
+      elif $is_3g then "3g" else "unknown" end)
+   else
+     (if $legacy_endc then "nsa" elif $legacy_sa then "sa"
+      elif $legacy_lte then "lte" elif $legacy_3g then "3g" else "unknown" end)
+   end) as $mode_group
+| (($primary | map(attach_metrics(.))) as $p
+   | ($bandcells | map(attach_metrics(.))) as $b
+   | ($qcacells | map(attach_metrics(.))) as $q
+   | ($legacycells | map(attach_metrics(.))) as $l
+   | merge_cells(merge_cells(merge_cells($p; $b); $q); $l)
+   | map(if $mode_group == "nsa" and .rat == "nr" and .role != "scc"
+         then .role = "nsa" else . end)) as $cells
+| ($cells | map(select(.role == "scc")) | length) as $scc_count
+| ($cells | map(select(.rat == "nr")) | length) as $nr_count
+| ($cells | length) as $carrier_count
+| (($scc_count > 0)) as $ca_active
+| ($simi."SIM Status" | text) as $sim_status
+| ($iface0.up // false) as $iface_up
+| (if $source == "qmodem" then
+     (if $sim_status == "miss" then "sim_missing"
+      elif ($cells | length) > 0 then "registered"
+      elif $sim_status == "ready" then "not_registered"
+      else "unavailable" end)
+   else
+     (($legacy0.registration | text) as $reg
+      | if ($reg == "1" or $reg == "5" or $reg == "6" or $reg == "7") then "registered"
+        elif $reg == "2" then "searching"
+        elif $reg == "3" then "denied"
+        elif $reg == "0" then "not_registered"
+        else "unavailable" end)
+   end) as $status
+| ($cells | map(select(.role == "pcc")) | first) as $pcc
+| ($cells | map(select(.rat == "nr" and .role != "scc")) | first) as $nr_serving
+| (if $mode_group == "nsa" then "5G NSA"
+   elif $mode_group == "sa" then "5G SA"
+   elif $mode_group == "lte" then (if $ca_active then "LTE-A" else "LTE" end)
+   elif $mode_group == "3g" then "3G"
+   else "Unknown" end) as $mode_label
+| (($primary | length) > 0 or ($bandcells | length) > 0 or ($qcacells | length) > 0
+   or ($legacycells | length) > 0) as $has_cells
+# The collector passes 1/0, JSON fixtures often pass true/false; accept both so a
+# caller can never claim a capability the data does not support.
+| (($qca_ok == 1) or ($qca_ok == true)) as $qca_avail
+| (($has_neighbors == 1) or ($has_neighbors == true)) as $neighbors_avail
+| {
+    meta: {
+      generated: $generated,
+      cached: false,
+      age_seconds: 0,
+      source: $source,
+      qmodem_section: (($section | text) // null),
+      sample_ttl: $sample_ttl,
+      duration_ms: ($ARGS.named.duration_ms // null),
+      neighbor_min_interval: $neighbor_min,
+      neighbor_ttl: $neighbor_ttl,
+      neighbor_age_seconds: null,
+      qca_ok: $qca_avail,
+      warnings: ([ $warnings | split("\n")[] | text | select(. != null) ])
+    },
+    connection: {
+      status: $status,
+      registered: ($status == "registered"),
+      label: (if $status == "registered" then "Registered"
+              elif $status == "sim_missing" then "SIM missing"
+              elif $status == "searching" then "Searching for network"
+              elif $status == "not_registered" then "Not registered"
+              elif $status == "denied" then "Registration denied"
+              else "Modem not ready" end),
+      mode: $mode_label,
+      mode_group: $mode_group,
+      endc: ($mode_group == "nsa"),
+      ca_active: $ca_active,
+      carrier_count: $carrier_count,
+      operator: (($simi.ISP | text) // ($legacy0.operator_name | text)),
+      mcc: (($lte.MCC | text) // ($root.MCC | text) // ($legacy0.operator_mcc | text)),
+      mnc: (($lte.MNC | text) // ($root.MNC | text) // ($legacy0.operator_mnc | text)),
+      sim_status: $sim_status,
+      iface: (($iface0.interface | text) // ($legacy0.network | text)),
+      l3_device: (($iface0.l3_device | text) // null),
+      iface_up: $iface_up,
+      uptime: (($iface0.uptime | number) // ($legacy0.conn_time_sec | number)),
+      rx_bytes: (($iface0.rx_bytes | number) // ($legacy0.rx | number)),
+      tx_bytes: (($iface0.tx_bytes | number) // ($legacy0.tx | number)),
+      model: (($basei.name | text) // ($legacy0.modem | text)),
+      manufacturer: ($basei.manufacturer | text),
+      firmware: (($basei.revision | text) // ($legacy0.firmware | text)),
+      temperature: (($basei.temperature | text) // ($legacy0.mtemp | text)),
+      protocol: ($legacy0.protocol | text)
+    },
+    identity: {
+      imei: (($simi.IMEI | text) // ($legacy0.imei | text)),
+      imsi: (($simi.IMSI | text) // ($legacy0.imsi | text)),
+      iccid: (($simi.ICCID | text) // ($legacy0.iccid | text)),
+      sim_slot: (($simi."SIM Slot" | text) // ($legacy0.simslot | text))
+    },
+    cells: $cells,
+    capabilities: {
+      per_carrier_metrics: $qca_avail,
+      neighbors: $neighbors_avail,
+      nr: ($nr_count > 0),
+      ca: $ca_active,
+      source: $source
+    },
+    neighbors: {
+      lte: [],
+      nr: [],
+      scanned: null,
+      available: $neighbors_avail,
+      error: (if $neighbors_avail then null else "Neighbour scans require QModem on this router." end),
+      cached: false
+    }
+  }
diff --git a/luci-app-3ginfo-lite/root/usr/share/3ginfo-lite/radio-qca.awk b/luci-app-3ginfo-lite/root/usr/share/3ginfo-lite/radio-qca.awk
new file mode 100644
index 0000000..651dc5f
--- /dev/null
+++ b/luci-app-3ginfo-lite/root/usr/share/3ginfo-lite/radio-qca.awk
@@ -0,0 +1,85 @@
+# Parse the measurement fields AT+QCAINFO reports for one component carrier.
+#
+# Quectel firmware does not keep one field order across LTE and NR, and several
+# releases print "-" for a measurement they do not expose. The parser therefore
+# takes the type, channel, band, and PCI by position, then accepts the remaining
+# numbers only when they fall inside the range 3GPP defines for RSRP, RSRQ, RSSI
+# or SINR. A missing field stays empty; nothing is inferred.
+#
+# Output is one tab-separated row per carrier:
+#   channel pci rsrp rsrq rssi sinr rat band type
+#
+# GPL-3.0. Part of luci-app-3ginfo-lite.
+
+BEGIN {
+    FS = ","
+    OFS = "\t"
+}
+
+function trim(v) {
+    gsub(/^[ \t\r"]+|[ \t\r"]+$/, "", v)
+    return v
+}
+
+function numeric(v) {
+    v = trim(v)
+    if (v == "" || v == "-" || v !~ /^-?[0-9]+(\.[0-9]+)?$/)
+        return ""
+    return v
+}
+
+/\+QCAINFO:/ {
+    line = $0
+    sub(/^.*\+QCAINFO:[ \t]*/, "", line)
+    n = split(line, f, ",")
+    if (n < 6)
+        next
+
+    type = tolower(trim(f[1]))
+    channel = numeric(f[2])
+    band = trim(f[4])
+    rat = (band ~ /NR/ ? "nr" : (band ~ /LTE/ ? "lte" : ""))
+    if (channel == "" || rat == "")
+        next
+
+    pci = numeric(f[6])
+    if (pci != "" && (pci + 0 < 0 || pci + 0 > 1007))
+        pci = ""
+    start = 7
+
+    # NR QCAINFO places the subcarrier spacing between PCI and RSRP. It is a
+    # configuration value (0/15/30/60/120), not a signal measurement.
+    if (rat == "nr" && start == 7) {
+        scs = numeric(f[7])
+        if (scs == "0" || scs == "15" || scs == "30" || scs == "60" || scs == "120")
+            start = 8
+    }
+
+    rsrp = rsrq = rssi = sinr = ""
+    for (i = start; i <= n; i++) {
+        v = numeric(f[i])
+        if (v == "")
+            continue
+        x = v + 0
+        if (rsrp == "" && x >= -140 && x <= -44) {
+            rsrp = v
+            continue
+        }
+        if (rsrq == "" && x >= -19.5 && x <= -3) {
+            rsrq = v
+            continue
+        }
+        if (rssi == "" && x >= -120 && x <= -25) {
+            rssi = v
+            continue
+        }
+        if (sinr == "" && x >= -20 && x <= 40) {
+            sinr = v
+            continue
+        }
+    }
+
+    print channel, (pci == "" ? "-" : pci), (rsrp == "" ? "-" : rsrp),
+          (rsrq == "" ? "-" : rsrq), (rssi == "" ? "-" : rssi),
+          (sinr == "" ? "-" : sinr), rat, band, (type == "" ? "scc" : type)
+}
diff --git a/luci-app-3ginfo-lite/root/usr/share/3ginfo-lite/radiodata.sh b/luci-app-3ginfo-lite/root/usr/share/3ginfo-lite/radiodata.sh
new file mode 100755
index 0000000..fe344b5
--- /dev/null
+++ b/luci-app-3ginfo-lite/root/usr/share/3ginfo-lite/radiodata.sh
@@ -0,0 +1,504 @@
+#!/bin/sh
+# radiodata.sh - one cached, normalized radio snapshot for 3gInfo-lite.
+#
+# The LuCI page must not run a fresh batch of modem commands on every browser
+# poll. This collector builds one document, keeps it in /tmp for a short time,
+# and serializes its own runs with a lock. When QModem is installed its ubus
+# methods are used: QModem owns the modem's AT port and already queues access
+# to it. Without QModem the collector falls back to 3ginfo.sh, which is the same
+# path this package used before; fields that source cannot supply stay absent.
+#
+# Usage: radiodata.sh [json|refresh|neighbors]
+#   json       reuse a snapshot younger than SAMPLE_TTL, otherwise collect one
+#   refresh    collect unless the snapshot is younger than REFRESH_MIN
+#   neighbors  collect if needed, then ask QModem for a neighbour scan
+#
+# Output: one JSON object on stdout. Errors are JSON too, never a bare string.
+#
+# GPL-3.0. Part of luci-app-3ginfo-lite.
+
+set -u
+
+RES=${RADIO_RES:-/usr/share/3ginfo-lite}
+CACHE=${RADIO_CACHE:-/tmp/3ginfo-radio.json}
+ID_CACHE=${RADIO_ID_CACHE:-/tmp/3ginfo-radio-identity.json}
+LOCKDIR=${RADIO_LOCKDIR:-/var/lock/3ginfo-radio.lock}
+SAMPLE_TTL=25
+
+REFRESH_MIN=5
+NEIGHBOR_DEFAULT=5
+NEIGHBOR_TTL_DEFAULT=120
+ID_TTL=300
+LOCK_WAIT=${RADIO_LOCK_WAIT:-20}
+MODE="${1:-json}"
+
+umask 077
+
+json_error() {
+	if command -v jq >/dev/null 2>&1; then
+		jq -n --arg e "$1" '{error:$e}'
+	else
+		printf '{"error":"%s"}\n' "$(printf '%s' "$1" | tr -d '"\\\n')"
+	fi
+	exit 0
+}
+
+command -v jq >/dev/null 2>&1 || json_error "jq is required by the radio collector"
+[ -r "$RES/radio-normalize.jq" ] || json_error "radio-normalize.jq is missing"
+[ -r "$RES/radio-qca.awk" ] || json_error "radio-qca.awk is missing"
+[ -r "$RES/radio-neighbors.jq" ] || json_error "radio-neighbors.jq is missing"
+
+case "$MODE" in
+	json|refresh|neighbors) ;;
+	*) json_error "unknown mode: $MODE" ;;
+esac
+
+now=$(date +%s)
+TMP=$(mktemp -d /tmp/3ginfo-radio.XXXXXX) || json_error "cannot create a temporary directory"
+WARN="$TMP/warnings"
+: > "$WARN"
+
+LOCK_HELD=0
+cleanup() {
+	rm -rf "$TMP"
+	[ "$LOCK_HELD" = 1 ] && rm -rf "$LOCKDIR"
+}
+trap cleanup EXIT
+trap 'exit 1' HUP INT TERM
+
+warn() {
+	printf '%s\n' "$1" >> "$WARN"
+}
+
+# A tiny mkdir lock: no dependency on util-linux flock, and a dead collector's
+# pid is detected so a power cut cannot leave the page permanently busy.
+acquire_lock() {
+	i=0
+	while ! mkdir "$LOCKDIR" 2>/dev/null; do
+		pid=$(cat "$LOCKDIR/pid" 2>/dev/null || true)
+		if [ -n "$pid" ] && ! kill -0 "$pid" 2>/dev/null; then
+			rm -rf "$LOCKDIR"
+			continue
+		fi
+		i=$((i + 1))
+		# BusyBox sleep has no fractional seconds, so wait in whole seconds and
+		# keep the count small: a snapshot takes about one second, a neighbour
+		# scan at most the ubus timeout.
+		[ "$i" -ge "$LOCK_WAIT" ] && return 1
+		sleep 1
+	done
+	printf '%s\n' "$$" > "$LOCKDIR/pid"
+	LOCK_HELD=1
+}
+
+# Whole milliseconds from /proc/uptime. date(1) on OpenWrt has no %N, and the
+# collection duration is reported to the page, so read the kernel's clock.
+now_ms() {
+	awk '{ printf "%d\n", $1 * 1000 }' /proc/uptime 2>/dev/null || echo 0
+}
+
+cache_age() {
+	[ -s "$CACHE" ] || { echo 999999; return; }
+	jq -r --argjson now "$now" '
+		((.meta.generated // 0) | tonumber) as $g
+		| if $g > 0 then ($now - $g) else 999999 end
+	' "$CACHE" 2>/dev/null || echo 999999
+}
+
+neighbor_age() {
+	[ -s "$CACHE" ] || { echo 999999; return; }
+	jq -r --argjson now "$now" '
+		(.neighbors.scanned // 0) as $g
+		| if $g > 0 then ($now - $g) else 999999 end
+	' "$CACHE" 2>/dev/null || echo 999999
+}
+
+emit_cache() {
+	jq --argjson now "$now" '
+		.meta.cached = true
+		| .meta.age_seconds = ([0, ($now - (.meta.generated // $now))] | max)
+		| .meta.neighbor_age_seconds =
+			(if (.neighbors.scanned // null) != null
+			 then ([0, ($now - .neighbors.scanned)] | max)
+			 else null end)
+	' "$CACHE"
+}
+
+emit_new() {
+	local out="$1"
+	jq --argjson now "$now" '
+		.meta.cached = false
+		| .meta.age_seconds = ([0, ($now - (.meta.generated // $now))] | max)
+		| .meta.neighbor_age_seconds =
+			(if (.neighbors.scanned // null) != null
+			 then ([0, ($now - .neighbors.scanned)] | max)
+			 else null end)
+	' "$out"
+}
+
+iface_name() {
+	local i
+	i=$(uci -q get 3ginfo.@3ginfo[0].network 2>/dev/null || true)
+	[ -n "$i" ] || i=$(uci show network 2>/dev/null |
+		sed -n 's/^network\.\([^.=]*\)\.modem_config=.*/\1/p' | head -n 1)
+	[ -n "$i" ] || i=wan
+	printf '%s' "$i"
+}
+
+qmodem_section() {
+	local s
+	if [ -n "$IFACE" ]; then
+		s=$(uci -q get "network.$IFACE.modem_config" 2>/dev/null || true)
+	fi
+	[ -n "$s" ] || s=$(uci show qmodem 2>/dev/null |
+		sed -n 's/^qmodem\.\([^.=]*\)=modem-device$/\1/p' | head -n 1)
+	printf '%s' "$s"
+}
+
+read_neighbor_interval() {
+	local v
+	v=$(uci -q get 3ginfo.@3ginfo[0].radio_neighbor_interval 2>/dev/null || true)
+	case "$v" in
+		''|*[!0-9]*) echo "$NEIGHBOR_DEFAULT" ;;
+		*)
+			[ "$v" -lt 5 ] && v=5
+			[ "$v" -gt 3600 ] && v=3600
+			echo "$v"
+			;;
+	esac
+}
+
+qmodem_section_args() {
+	jq -nc --arg s "$1" '{config_section:$s}'
+}
+
+qmodem_call() {
+	local method="$1" out="$2" req
+	req=$(qmodem_section_args "$SECTION")
+	if timeout 15 ubus -t 12 call qmodem "$method" "$req" > "$out" 2>/dev/null &&
+	   jq -e 'type == "object"' "$out" >/dev/null 2>&1; then
+		return 0
+	fi
+	echo '{}' > "$out"
+	warn "QModem did not answer $method."
+	return 1
+}
+
+# Identity changes rarely. Cache it separately so a 25-second sample does not
+# read the SIM on every collection.
+collect_identity() {
+	local out="$TMP/sim.json" fresh="$TMP/sim.fresh.json" age=999999
+	if [ -s "$ID_CACHE" ]; then
+		age=$(jq -r --argjson now "$now" '
+			((.generated // 0) | tonumber) as $g
+			| if $g > 0 then ($now - $g) else 999999 end
+		' "$ID_CACHE" 2>/dev/null || echo 999999)
+	fi
+	if [ "$age" -le "$ID_TTL" ]; then
+		jq '.data // {}' "$ID_CACHE" > "$out" 2>/dev/null || echo '{}' > "$out"
+		return 0
+	fi
+	if qmodem_call sim_info "$fresh" &&
+	   jq -e '.modem_info | type == "array" and length > 0' "$fresh" >/dev/null 2>&1; then
+		jq --argjson now "$now" '{generated:$now, data:.}' "$fresh" > "$ID_CACHE" 2>/dev/null || true
+		chmod 600 "$ID_CACHE" 2>/dev/null || true
+		cp "$fresh" "$out"
+		return 0
+	fi
+	warn "SIM identity could not be read; keeping the last known values."
+	if [ -s "$ID_CACHE" ]; then
+		jq '.data // {}' "$ID_CACHE" > "$out" 2>/dev/null || echo '{}' > "$out"
+	else
+		echo '{}' > "$out"
+	fi
+}
+
+collect_qca() {
+	local raw="$TMP/qca.raw" text="$TMP/qca.txt" req status
+	: > "$text"
+	QCA_OK=0
+	[ "$HAVE_QMODEM" = 1 ] || return 0
+	[ -n "$AT_PORT" ] || { warn "QModem has no AT port configured; per-carrier measurements are unavailable."; return 0; }
+	command -v ubus >/dev/null 2>&1 || return 0
+	ubus -v list qmodem 2>/dev/null | grep -q '"send_at"' || {
+		warn "QModem does not expose send_at; per-carrier measurements are unavailable."
+		return 0
+	}
+	req=$(jq -nc --arg s "$SECTION" --arg at "AT+QCAINFO" \
+		--arg p "$AT_PORT" --arg ub "$USE_UBUS" \
+		'{config_section:$s,params:{at:$at,port:$p,use_ubus_flag:$ub}}')
+	if ! timeout 15 ubus -t 12 call qmodem send_at "$req" > "$raw" 2>/dev/null; then
+		warn "AT+QCAINFO did not answer; secondary-carrier measurements are unavailable."
+		return 0
+	fi
+	status=$(jq -r '.at_cfg.status // "0"' "$raw" 2>/dev/null || echo 0)
+	if [ "$status" != "1" ]; then
+		warn "AT+QCAINFO was refused; secondary-carrier measurements are unavailable."
+		return 0
+	fi
+	jq -r '.at_cfg.res // empty' "$raw" > "$TMP/qca.text" 2>/dev/null || true
+	awk -f "$RES/radio-qca.awk" "$TMP/qca.text" > "$text" 2>/dev/null || true
+	QCA_OK=1
+}
+
+collect_iface() {
+	local st="$TMP/ifstatus.json" l3 up uptime rx tx
+	echo '{}' > "$st"
+	if command -v ifstatus >/dev/null 2>&1 && [ -n "$IFACE" ]; then
+		ifstatus "$IFACE" > "$st" 2>/dev/null || echo '{}' > "$st"
+	fi
+	up=$(jq -r '.up // false' "$st" 2>/dev/null || echo false)
+	l3=$(jq -r '.l3_device // empty' "$st" 2>/dev/null || true)
+	uptime=$(jq -r '.uptime // empty' "$st" 2>/dev/null || true)
+	rx=
+	tx=
+	if [ -n "$l3" ] && [ -r "/sys/class/net/$l3/statistics/rx_bytes" ]; then
+		rx=$(cat "/sys/class/net/$l3/statistics/rx_bytes" 2>/dev/null || true)
+		tx=$(cat "/sys/class/net/$l3/statistics/tx_bytes" 2>/dev/null || true)
+	fi
+	[ -n "$rx" ] || rx=null
+	[ -n "$tx" ] || tx=null
+	[ -n "$uptime" ] || uptime=null
+	jq -n --arg interface "$IFACE" --arg l3 "$l3" \
+		--argjson up "$up" --argjson uptime "$uptime" \
+		--argjson rx "$rx" --argjson tx "$tx" \
+		'{interface:$interface, l3_device:$l3, up:$up, uptime:$uptime, rx_bytes:$rx, tx_bytes:$tx}' \
+		> "$TMP/iface.json"
+}
+
+collect_legacy() {
+	: > "$TMP/legacy.json"
+	if [ -r "$RES/3ginfo.sh" ] &&
+	   timeout 25 sh "$RES/3ginfo.sh" json > "$TMP/legacy.json" 2>/dev/null &&
+	   jq -e 'type == "object"' "$TMP/legacy.json" >/dev/null 2>&1; then
+		return 0
+	fi
+	echo '{}' > "$TMP/legacy.json"
+	warn "3ginfo.sh did not return a readable snapshot."
+	return 1
+}
+
+collect_sample() {
+	local out="$TMP/snapshot.json" base="$TMP/base.json" cell="$TMP/cell.json" band="$TMP/band.json"
+	local started finished
+
+	started=$(now_ms)
+	IFACE=$(iface_name)
+	SECTION=$(qmodem_section)
+	HAVE_QMODEM=0
+	if command -v ubus >/dev/null 2>&1 &&
+	   timeout 5 ubus -t 5 list qmodem >/dev/null 2>&1 && [ -n "$SECTION" ]; then
+		HAVE_QMODEM=1
+	fi
+
+	AT_PORT=$(uci -q get "qmodem.$SECTION.at_port" 2>/dev/null || true)
+	override=$(uci -q get "qmodem.$SECTION.override_at_port" 2>/dev/null || true)
+	[ -n "$override" ] && AT_PORT=$override
+	USE_UBUS=$(uci -q get "qmodem.$SECTION.use_ubus" 2>/dev/null || true)
+	USE_UBUS=${USE_UBUS:-1}
+
+	echo '{}' > "$base"
+	echo '{}' > "$cell"
+	echo '{}' > "$band"
+	echo '{}' > "$TMP/sim.json"
+	echo '{}' > "$TMP/legacy.json"
+
+	if [ "$HAVE_QMODEM" = 1 ]; then
+		SOURCE=qmodem
+		qmodem_call base_info "$base" || true
+		qmodem_call cell_info "$cell" || true
+		qmodem_call get_current_band "$band" || true
+
+		# A configured QModem whose daemon is stopped answers neither method.
+		# Fall back to the package's own collector rather than claiming the
+		# modem is absent.
+		if ! jq -e '.modem_info | type == "array" and length > 0' "$base" >/dev/null 2>&1 &&
+		   ! jq -e '.modem_info | type == "array" and length > 0' "$cell" >/dev/null 2>&1; then
+			warn "QModem returned no modem data; falling back to 3ginfo."
+			HAVE_QMODEM=0
+			SOURCE=legacy
+			collect_legacy || true
+		else
+			collect_identity
+		fi
+	else
+		SOURCE=legacy
+		collect_legacy || true
+		warn "QModem was not found; detailed carrier and neighbour telemetry is unavailable."
+	fi
+
+	collect_qca
+	collect_iface
+
+	HAS_NEIGHBORS=0
+	if [ "$HAVE_QMODEM" = 1 ]; then
+		if ubus -v list qmodem 2>/dev/null | grep -q '"get_neighborcell"'; then
+			HAS_NEIGHBORS=1
+		else
+			warn "QModem does not expose neighbour-cell scans on this router."
+		fi
+	fi
+
+	finished=$(now_ms)
+	DURATION_MS=$((finished - started))
+	[ "$DURATION_MS" -ge 0 ] 2>/dev/null || DURATION_MS=0
+
+	if ! jq -n \
+		--arg source "$SOURCE" \
+		--arg section "$SECTION" \
+		--argjson generated "$now" \
+		--argjson duration_ms "$DURATION_MS" \
+		--argjson qca_ok "$QCA_OK" \
+		--argjson has_neighbors "$HAS_NEIGHBORS" \
+		--argjson sample_ttl "$SAMPLE_TTL" \
+		--argjson neighbor_min "$NEIGHBOR_MIN" \
+		--argjson neighbor_ttl "$NEIGHBOR_TTL" \
+		--rawfile warnings "$WARN" \
+		--slurpfile base "$base" \
+		--slurpfile cell "$cell" \
+		--slurpfile band "$band" \
+		--slurpfile sim "$TMP/sim.json" \
+		--slurpfile legacy "$TMP/legacy.json" \
+		--slurpfile iface "$TMP/iface.json" \
+		--rawfile qca "$TMP/qca.txt" \
+		-f "$RES/radio-normalize.jq" > "$out"; then
+		json_error "Telemetry normalization failed"
+	fi
+
+	# Preserve the last neighbour table when this collection did not scan. A
+	# neighbour scan is a separate, slower action and must not disappear just
+	# because the 25-second sample refreshed.
+	if [ -s "$CACHE" ] && jq -e '.neighbors | type == "object"' "$CACHE" >/dev/null 2>&1; then
+		jq --slurpfile old "$CACHE" '.neighbors = ($old[0].neighbors // .neighbors)' "$out" > "$out.tmp" &&
+			mv "$out.tmp" "$out"
+	fi
+
+	# QModem does not always carry an operator name in cell_info: its SIM "ISP"
+	# field is often just the numeric MCC/MNC. The MCC/MNC table this package
+	# already ships fills that gap without another AT call.
+	op=$(jq -r '.connection.operator // empty' "$out")
+	case "$op" in
+		''|*[!0-9]*) ;;
+		*) op='' ;;
+	esac
+	if [ -z "$op" ]; then
+		key=$(jq -r '(.connection.mcc // "") + (.connection.mnc // "")' "$out")
+		case "$key" in
+			''|*[!0-9]*) ;;
+			*)
+				# The table ships with CRLF line endings (upstream format), so
+				# the third field keeps a stray \r unless it is stripped here.
+				op=$(awk -F';' -v k="$key" '$1 == k { sub(/\r$/, "", $3); print $3; exit }' "$RES/mccmnc.dat" 2>/dev/null || true)
+				[ -n "$op" ] && jq --arg op "$op" '.connection.operator = $op' "$out" > "$out.tmp" &&
+					mv "$out.tmp" "$out"
+				;;
+		esac
+	fi
+
+	chmod 600 "$out" 2>/dev/null || true
+	mv "$out" "$TMP/final.json"
+	cp "$TMP/final.json" "$CACHE.tmp"
+	chmod 600 "$CACHE.tmp" 2>/dev/null || true
+	mv "$CACHE.tmp" "$CACHE"
+}
+
+scan_neighbors() {
+	local raw="$TMP/neighbors.raw" norm="$TMP/neighbors.json" req available=false error=""
+
+	# A cached sample skips collect_sample, so establish the QModem facts here
+	# before deciding whether a scan is possible.
+	IFACE=${IFACE:-$(iface_name)}
+	SECTION=${SECTION:-$(qmodem_section)}
+	if [ -z "${HAVE_QMODEM:-}" ]; then
+		HAVE_QMODEM=0
+		if command -v ubus >/dev/null 2>&1 &&
+		   timeout 5 ubus -t 5 list qmodem >/dev/null 2>&1 && [ -n "$SECTION" ]; then
+			HAVE_QMODEM=1
+		fi
+	fi
+
+	if [ "$HAVE_QMODEM" != 1 ] ||
+	   ! ubus -v list qmodem 2>/dev/null | grep -q '"get_neighborcell"'; then
+		error="Neighbour scans require QModem on this router."
+	else
+		req=$(qmodem_section_args "$SECTION")
+		if timeout 30 ubus -t 25 call qmodem get_neighborcell "$req" > "$raw" 2>/dev/null &&
+		   jq -e '.neighborcell | type == "object"' "$raw" >/dev/null 2>&1; then
+			available=true
+		else
+			error="The modem did not return a neighbour-cell report."
+			echo '{}' > "$raw"
+		fi
+	fi
+	[ -n "$error" ] && warn "$error"
+
+	jq -n --argjson available "$available" --arg error "$error" --argjson now "$now" \
+		--slurpfile raw "$raw" -f "$RES/radio-neighbors.jq" > "$norm" ||
+		json_error "Neighbour normalization failed"
+
+	if jq -e '.available == true' "$norm" >/dev/null 2>&1; then
+		jq --slurpfile n "$norm" '.neighbors = $n[0]' "$TMP/final.json" > "$CACHE.tmp"
+	else
+		jq --slurpfile n "$norm" '
+			.neighbors = ((.neighbors // {}) + {
+				available: ((.neighbors.available // false) or ((.neighbors.lte // []) | length) > 0 or ((.neighbors.nr // []) | length) > 0),
+				error: $n[0].error,
+				cached: false
+			})
+		' "$TMP/final.json" > "$CACHE.tmp"
+	fi
+	chmod 600 "$CACHE.tmp" 2>/dev/null || true
+	mv "$CACHE.tmp" "$CACHE"
+}
+
+NEIGHBOR_MIN=$(read_neighbor_interval)
+NEIGHBOR_TTL=$NEIGHBOR_MIN
+[ "$NEIGHBOR_TTL" -lt "$NEIGHBOR_TTL_DEFAULT" ] && NEIGHBOR_TTL=$NEIGHBOR_TTL_DEFAULT
+
+if ! acquire_lock; then
+	if [ -s "$CACHE" ]; then
+		jq --argjson now "$now" '.meta.busy = true | .meta.cached = true
+			| .meta.age_seconds = ([0, ($now - (.meta.generated // $now))] | max)' "$CACHE"
+	else
+		json_error "The radio collector is busy; try again."
+	fi
+	exit 0
+fi
+
+case "$MODE" in
+	json)
+		if [ "$(cache_age)" -le "$SAMPLE_TTL" ]; then
+			emit_cache
+			exit 0
+		fi
+		collect_sample
+		emit_new "$TMP/final.json"
+		;;
+	refresh)
+		# -lt, not -le: a 5-second page interval asks exactly at the boundary,
+		# and a request that is exactly at the minimum is not too early.
+		if [ "$(cache_age)" -lt "$REFRESH_MIN" ]; then
+			emit_cache | jq '.meta.rate_limited = true'
+			exit 0
+		fi
+		collect_sample
+		emit_new "$TMP/final.json"
+		;;
+	neighbors)
+		# The page can run scans and refreshes at the same short interval, and
+		# a scan carries the serving snapshot with it. Resample on the same
+		# boundary the refresh uses, so one scan keeps the whole page current
+		# instead of the summary lagging a whole interval behind it.
+		if [ "$(cache_age)" -ge "$REFRESH_MIN" ]; then
+			collect_sample
+		else
+			cp "$CACHE" "$TMP/final.json"
+		fi
+		if [ "$(neighbor_age)" -lt "$NEIGHBOR_MIN" ]; then
+			emit_new "$TMP/final.json" | jq '.meta.neighbor_rate_limited = true'
+			exit 0
+		fi
+		scan_neighbors
+		emit_new "$CACHE"
+		;;
+esac
